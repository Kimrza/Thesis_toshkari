#!/bin/sh
# .githooks/pre-commit — the incremental secret scan + critical test set (SD-01; Q7=D).
#
# Purpose: the preventive net. Runs on every `git commit`:
#   1. gitleaks (pinned 8.18.4) over the STAGED DIFF only — this mode is a net,
#      never TA-22 evidence (SD-01: the gate scan via scripts/gate_secret_scan.py
#      is the only evidence-producing mode);
#   2. the critical test set (team.md § Testing Posture, Q7=D: a pre-commit hook
#      runs the critical set on every commit once git exists).
# Inputs: the staged index; .gitleaks.toml; the tests/ tree.
# Re-run behaviour: pure check — writes nothing, mutates nothing. A failure
#   blocks the commit; fixing the cause and re-committing is the re-run path.
#
# Enable with:  git config core.hooksPath .githooks
#
# NOT YET ENABLED. `git config core.hooksPath` is UNSET, `.git/hooks/` holds only Git's
# stock samples, and no commit in this repository's history has been gated by this hook
# (Recommendation 35). Enabling it is a STUDENT act — CR-2026-09-20-GOV-CG-01-DISPOSITIONS
# §5 item 4 — and no agent has run or may run that command. Its stated precondition, the
# Recommendation 30 restricted-case deselection in §2 below, LANDED 2026-09-20, so the
# sequencing bar is clear: enabling the hook no longer makes every commit perform a
# December restricted read. Record the activation date and the first commit it gated.

set -e

PINNED_GITLEAKS="8.18.4"

# --- 1. incremental secret scan (staged diff; preventive, not evidence) ---------------
if command -v gitleaks >/dev/null 2>&1; then
    ACTUAL=$(gitleaks version 2>/dev/null | tr -d 'v \r\n' || true)
    if [ "$ACTUAL" != "$PINNED_GITLEAKS" ]; then
        echo "pre-commit: gitleaks $ACTUAL found but $PINNED_GITLEAKS is pinned" >&2
        echo "pre-commit: refusing to scan with an unpinned tool (SD-01)" >&2
        exit 1
    fi
    gitleaks protect --staged --config .gitleaks.toml --redact --exit-code 1 || {
        echo "pre-commit: gitleaks found a candidate secret in the staged diff." >&2
        echo "pre-commit: a credential that reaches history needs a history rewrite" >&2
        echo "pre-commit: that would break freeze-gate tags (SD-01). Commit blocked." >&2
        exit 1
    }
else
    # Fail CLOSED on the scan being unavailable: an unscanned commit is exactly
    # the event the deny-list + scan pair exists to prevent (NFR-SEC-01).
    echo "pre-commit: gitleaks $PINNED_GITLEAKS is not installed; commit blocked." >&2
    echo "pre-commit: install it (see README.md § Tooling) or run with --no-verify" >&2
    echo "pre-commit: ONLY under an explicit, recorded human decision." >&2
    exit 1
fi

# --- 1b. notebook saved-output refusal (SD-A-02 limb 2, Q3=A; R-39) --------------------
# A staged .ipynb carrying saved outputs or execution counts fails CLOSED: the
# author clears outputs and re-commits. NOTHING is auto-stripped -- a silent
# rewrite of staged content defeats the D-number citation rule (team.md § Way of
# Working), and a credential in committed history needs a history rewrite that
# would rewrite freeze-gate tags. The check reads the STAGED blob (git show :path),
# not the working tree, so what is checked is what would be committed. The logic
# lives in src/data/acquisition.py (notebook_output_violations) so it is testable;
# this hook is its caller.
STAGED_NOTEBOOKS=$(git diff --cached --name-only --diff-filter=ACM | grep '\.ipynb$' || true)
if [ -n "$STAGED_NOTEBOOKS" ]; then
    if ! command -v python >/dev/null 2>&1; then
        echo "pre-commit: python unavailable; staged notebook outputs NOT checked; commit blocked." >&2
        echo "pre-commit: the output check fails closed (SD-A-02, Q3=A)." >&2
        exit 1
    fi
    for nb in $STAGED_NOTEBOOKS; do
        git show ":$nb" | python -m src.data.acquisition check-notebook-outputs --name "$nb" || {
            echo "pre-commit: staged notebook '$nb' carries saved outputs or execution counts" >&2
            echo "pre-commit: (or could not be parsed -- an unparseable notebook fails closed)." >&2
            echo "pre-commit: clear all outputs, restage, and re-commit. Outputs are never" >&2
            echo "pre-commit: auto-stripped (SD-A-02 limb 2, Q3=A). Commit blocked." >&2
            exit 1
        }
    done
fi

# --- 2. critical test set (Q7=D), SPLIT BY RESTRICTED-CONTENT ACCESS -------------------
#
# WHAT CHANGED AND WHY (Recommendation 30, 2026-09-20; owner authorised option 1).
# This list was a single set run unconditionally on every commit, and three of its modules
# OBTAIN December restricted CONTENT. Enabling the hook as it stood would have made an
# ordinary developer commit perform a December restricted-root read, with no per-occasion
# human authorization -- Vision §8.3's authorization limb is meant to be a decision, not a
# constant, and a boundary whose crossing is triggered by `git commit` cannot be described
# to a supervisor as a governed access. `evidence/experiment_registry.md:102-109` already
# argues for exactly this split in writing.
#
# THE SPLIT CRITERION, stated so it can be re-applied rather than guessed: a module belongs
# to the gate-only set when it READS BYTES from under `evidence/locked_test_restricted/`.
# Merely resolving a path through `open_restricted`, or constructing an `AccessRecord`
# against a `tmp_path` registry, is NOT restricted-content access -- those modules are the
# guard's own controls and removing them would delete the very check that protects the
# boundary at the moment it matters most.
#
# Derived 2026-09-20 over the eight modules previously listed, printed before assertion:
#   tests/test_determinism.py                    reads no evidence root          -> commit
#   tests/test_experiment_registry.py            reads no evidence root          -> commit
#   tests/test_release_contract.py               reads no evidence root          -> commit
#   tests/test_locked_test_guard.py              open_restricted -> tmp_path row,
#                                                resolves a path, reads no bytes -> commit
#   tests/test_merge_script_restricted_reads.py  same shape (ACCESS_LOG rebound
#                                                to tmp_path; no byte read)      -> commit
#   tests/test_release_hashes.py                 _sha256() streams December bytes -> GATE
#   tests/test_acquisition_window.py             csv.DictReader over December rows-> GATE
#   tests/test_phase_boundary.py                 _csv_header() reads December rows-> GATE
#
# tests/test_phase_boundary.py is in the gate set for a reason that POST-DATES the finding:
# Recommendation 32's remediation routed its `_csv_header` through the chokepoint on the
# same day, which turned it into a fourth restricted reader. The finding named two modules
# because two was the truth when it was written; the criterion, not the enumeration, is what
# this hook applies.
#
# NOTHING IS LOST, ONLY MOVED. The gate-only modules keep running -- in the full suite
# before every acquisition or training run, before every governed run (freeze gate, phase
# transition), and inside the Kaggle session before any governed run executed there
# (TC-03g, binding: hard). That is where an authorization actually exists to be recorded.
#
# SEQUENCING, and the reason this block had to land first: `git config core.hooksPath
# .githooks` is Recommendation 35 and is a STUDENT act
# (CR-2026-09-20-GOV-CG-01-DISPOSITIONS §5 item 4), explicitly ordered AFTER this
# deselection -- enabling the hook before it would have created the problem rather than
# closed it. No agent has run, or may run, that command.

# Commit-time set: no restricted content is read by any module here.
CRITICAL_TESTS="
tests/test_determinism.py
tests/test_experiment_registry.py
tests/test_release_contract.py
tests/test_locked_test_guard.py
tests/test_merge_script_restricted_reads.py
"

# Gate/freeze-suite set: DESELECTED here. Each reads December restricted content and must
# run only on an occasion that carries an authorization to record.
RESTRICTED_TESTS="
tests/test_release_hashes.py
tests/test_acquisition_window.py
tests/test_phase_boundary.py
"

if command -v python >/dev/null 2>&1 && python -c "import pytest" >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    python -m pytest -q $CRITICAL_TESTS || {
        echo "pre-commit: critical test set failed; commit blocked (Q7=D)." >&2
        exit 1
    }
    echo "pre-commit: restricted-reader modules were NOT run (Recommendation 30):" >&2
    # shellcheck disable=SC2086
    for t in $RESTRICTED_TESTS; do echo "pre-commit:   $t" >&2; done
    echo "pre-commit: they read December content and belong to the gate/freeze suite," >&2
    echo "pre-commit: where an authorization exists to be recorded (Vision 8.3)." >&2
else
    echo "pre-commit: no python+pytest on PATH; critical test set NOT run; commit blocked." >&2
    exit 1
fi

exit 0
