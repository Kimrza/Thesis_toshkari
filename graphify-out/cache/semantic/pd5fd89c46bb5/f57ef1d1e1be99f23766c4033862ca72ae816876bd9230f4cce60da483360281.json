{"nodes": [{"id": "_claude_knowledge_aidlc_architecture_reviewer_agent_reviewing", "label": "Reviewing Artifacts (Architecture Lens)", "file_type": "document", "source_file": ".claude/knowledge/aidlc-architecture-reviewer-agent/reviewing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_knowledge_aidlc_architecture_reviewer_agent_reviewing_reviewer_stance", "label": "Reviewer Stance", "file_type": "rationale", "source_file": ".claude/knowledge/aidlc-architecture-reviewer-agent/reviewing.md", "source_location": "Stance", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The reviewer did not produce the work and deliberately has no access to the builder's plan.md or memory.md, so the design is judged on whether a developer could implement it without guessing. READY means implementable, not perfect."}, {"id": "_claude_knowledge_aidlc_architecture_reviewer_agent_reviewing_cross_unit_contract_verification", "label": "Cross-Unit Contract Verification Bound", "file_type": "rationale", "source_file": ".claude/knowledge/aidlc-architecture-reviewer-agent/reviewing.md", "source_location": "Functional Design", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scope is the passed artifacts plus the shared inception contracts (components.md, component-methods.md, services.md, unit-of-work.md) - not sibling units' functional-design prose, and never via grep, glob, or shell patterns spanning sibling unit paths. A named integration point is spot-checked by opening the owning file resolved through the shared contracts, never by sweeping the sibling unit."}, {"id": "_claude_knowledge_aidlc_architecture_reviewer_agent_reviewing_review_comment_format", "label": "Review Comment Format", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-architecture-reviewer-agent/reviewing.md", "source_location": "How to Lodge Review Comments", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single Review section appended to the primary artifact, carrying verdict, reviewer, ISO date obtained from a real shell date command rather than guessed, iteration number, a findings table with severity/location/recommendation, validation tool results with interpretation, and a summary. On later iterations the section is replaced, never duplicated."}, {"id": "_claude_knowledge_aidlc_architecture_reviewer_agent_reviewing_severity_levels", "label": "Finding Severity Levels", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-architecture-reviewer-agent/reviewing.md", "source_location": "Severity Levels", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Critical means failure at implementation or runtime and always blocks; Major means significant rework and blocks past two; Minor never blocks."}, {"id": "_claude_knowledge_aidlc_architecture_reviewer_agent_reviewing_verdict_rules", "label": "Verdict Rules", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-architecture-reviewer-agent/reviewing.md", "source_location": "Verdict Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "READY requires zero Critical and at most two Major with any number of Minor; a mechanical threshold rather than reviewer mood, so repeat iterations converge instead of drifting."}, {"id": "_claude_knowledge_aidlc_architecture_reviewer_agent_reviewing_validation_tools", "label": "Validation Tool Execution", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-architecture-reviewer-agent/reviewing.md", "source_location": "Validation Tools", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tools listed by the stage definition are run via shell before the review is written, and their output is interpreted rather than pasted - a tool failure can be acceptable with documented rationale."}], "edges": [{"source": "_claude_knowledge_aidlc_architecture_reviewer_agent_reviewing", "target": "_claude_knowledge_aidlc_architecture_reviewer_agent_reviewing_reviewer_stance", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-architecture-reviewer-agent/reviewing.md", "source_location": "Stance", "weight": 1}, {"source": "_claude_knowledge_aidlc_architecture_reviewer_agent_reviewing", "target": "_claude_knowledge_aidlc_architecture_reviewer_agent_reviewing_cross_unit_contract_verification", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-architecture-reviewer-agent/reviewing.md", "source_location": "Functional Design", "weight": 1}, {"source": "_claude_knowledge_aidlc_architecture_reviewer_agent_reviewing", "target": "_claude_knowledge_aidlc_architecture_reviewer_agent_reviewing_review_comment_format", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-architecture-reviewer-agent/reviewing.md", "source_location": "How to Lodge Review Comments", "weight": 1}, {"source": "_claude_knowledge_aidlc_architecture_reviewer_agent_reviewing", "target": "_claude_knowledge_aidlc_architecture_reviewer_agent_reviewing_severity_levels", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-architecture-reviewer-agent/reviewing.md", "source_location": "Severity Levels", "weight": 1}, {"source": "_claude_knowledge_aidlc_architecture_reviewer_agent_reviewing", "target": "_claude_knowledge_aidlc_architecture_reviewer_agent_reviewing_verdict_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-architecture-reviewer-agent/reviewing.md", "source_location": "Verdict Rules", "weight": 1}, {"source": "_c