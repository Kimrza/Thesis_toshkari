{"nodes": [{"id": "_claude_skills_caveman_skill_caveman", "label": "Caveman Communication Mode", "file_type": "document", "source_file": ".claude/skills/caveman/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Respond terse like smart caveman: all technical substance stays, only fluff dies. Pattern is `[thing] [action] [reason]. [next step].`"}, {"id": "_claude_skills_caveman_skill_intensity_levels", "label": "Six Caveman Intensity Levels", "file_type": "concept", "source_file": ".claude/skills/caveman/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "lite / full (default) / ultra / wenyan-lite / wenyan-full / wenyan-ultra, so compression can be dialled to context rather than being all-or-nothing."}, {"id": "_claude_skills_caveman_skill_auto_clarity_rule", "label": "Auto-Clarity Override", "file_type": "rationale", "source_file": ".claude/skills/caveman/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drop caveman for security warnings, irreversible-action confirmations, multi-step sequences where fragment order risks misread, cases where compression itself creates technical ambiguity, and when the user re-asks \u2014 then resume. Token savings never outrank comprehension where a misread is costly."}, {"id": "_claude_skills_caveman_skill_wenyan_modes", "label": "Wenyan Classical Chinese Modes", "file_type": "concept", "source_file": ".claude/skills/caveman/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "80-90% character reduction (characters, not tokens) via classical sentence patterns and particles; classical characters are permitted only in wenyan modes, never swapped in at other levels to shrink output."}, {"id": "_claude_skills_caveman_skill_no_invented_abbreviations", "label": "No Invented Abbreviations or Causal Arrows", "file_type": "rationale", "source_file": ".claude/skills/caveman/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Invented abbreviations (cfg/impl/req/res/fn) tokenize the same as the full word, so they save zero tokens while costing the reader decode effort; the full word is cheaper AND clearer. Causal arrows are their own token and likewise save nothing. Standard well-known acronyms (DB/API/HTTP) remain fine."}, {"id": "_claude_skills_caveman_skill_persistence_rule", "label": "Mode Persistence Rule", "file_type": "rationale", "source_file": ".claude/skills/caveman/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Active every response with no revert after many turns and no filler drift; still active if unsure; off only on explicit 'stop caveman' / 'normal mode'. Also forbids self-reference \u2014 never announce or name the style."}, {"id": "_claude_skills_caveman_skill_language_preservation", "label": "User Language Preservation Rule", "file_type": "concept", "source_file": ".claude/skills/caveman/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compress the style, not the language: reply in the user's dominant language regardless of example text. 'Drop articles' applies to article languages only \u2014 where small markers carry case or role (particles, postpositions) they are grammar, not filler, so politeness and filler are compressed instead."}, {"id": "_claude_skills_caveman_skill_boundaries_persisted_output", "label": "Persisted-Output Boundary", "file_type": "rationale", "source_file": ".claude/skills/caveman/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anything persisted outside the chat \u2014 code, comments, commits, docs, issue/PR text, memory files, third-party messages \u2014 is written in normal prose, because compression that reads fine in-session becomes an unexplained artefact once it outlives the conversation. /caveman-compress is the one exemption."}], "edges": [{"source": "_claude_skills_caveman_skill_caveman", "target": "_claude_skills_caveman_skill_intensity_levels", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/caveman/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_caveman_skill_intensity_levels", "target": "_claude_skills_caveman_skill_wenyan_modes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/caveman/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_caveman_skill_auto_clarity_rule", "target": "_claude_skills_caveman_skill_caveman", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/caveman/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_caveman_skill_no_invented_abbreviations", "target": "_claude_skills_caveman_skill_intensity_levels", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/caveman/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_caveman_skill_persistence_rule", "target": "_claude_skills_caveman_skill_caveman", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/caveman/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_caveman_skill_caveman", "target": "_claude_skills_caveman_skill_language_preservation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/caveman/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_caveman_skill_boundaries_persisted_output", "target": "_claude_skills_caveman_skill_caveman", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/caveman/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_caveman_skill_boundaries_persisted_output", "target": "_claude_skills_caveman_compress_skill_caveman_compress", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/caveman/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_caveman_skill_boundaries_persisted_output", "target": "_claude_skills_caveman_commit_skill_caveman_commit", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": ".claude/skills/caveman/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_caveman_skill_auto_clarity_rule", "target": "_claude_skills_caveman_commit_skill_body_required_cases", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/skills/caveman/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_caveman_skill_auto_clarity_rule", "target": "_claude_skills_caveman_review_readme_review_auto_clarity", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/skills/caveman/SKILL.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "caveman_auto_clarity_pattern", "label": "Cross-Skill Auto-Clarity Escape Hatch", "nodes": ["_claude_skills_caveman_skill_auto_clarity_rule", "_claude_skills_caveman_commit_skill_body_required_cases", "_claude_skills_caveman_review_readme_review_auto_clarity"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/skills/caveman/SKILL.md"}]}