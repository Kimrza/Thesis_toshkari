{"nodes": [{"id": "_claude_aidlc_common_stages_initialization_workspace_detection", "label": "Workspace Detection Stage", "file_type": "document", "source_file": ".claude/aidlc-common/stages/initialization/workspace-detection.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_aidlc_common_stages_initialization_workspace_detection_nested_project_fallback", "label": "Nested-Project Fallback", "file_type": "rationale", "source_file": ".claude/aidlc-common/stages/initialization/workspace-detection.md", "source_location": "Step 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When no top-level signal fires, descend one level into arbitrarily-named subdirectories and re-apply the same signal set, because a project whose source lives one container down (wordbook/, backend/) would otherwise be misclassified greenfield. Bounded to depth-1 and never run when the root already has a source signal, to keep the scan cheap and avoid pulling vendored or sibling projects into the classification."}, {"id": "_claude_aidlc_common_stages_initialization_workspace_detection_brownfield_classification", "label": "Brownfield Classification Signals", "file_type": "concept", "source_file": ".claude/aidlc-common/stages/initialization/workspace-detection.md", "source_location": "Step 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ANY of: source files in a recognized language, framework config, package manifest with application dependencies, application source directories, or a parseable .gitmodules with at least one submodule path \u2014 repo metadata declares code even when the submodule dirs are not yet initialized."}, {"id": "_claude_aidlc_common_stages_initialization_workspace_detection_greenfield_classification", "label": "Greenfield Classification Signals", "file_type": "concept", "source_file": ".claude/aidlc-common/stages/initialization/workspace-detection.md", "source_location": "Step 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ALL negative signals must hold. README, .gitignore, LICENSE, editor configs, empty dirs, CI/CD boilerplate without application code, the harness dir and aidlc/ never make a project brownfield, so framework scaffolding is not mistaken for the user's application."}, {"id": "_claude_aidlc_common_stages_initialization_workspace_detection_submodule_warning_relay", "label": "Uninitialized Submodule Warning Relay", "file_type": "rationale", "source_file": ".claude/aidlc-common/stages/initialization/workspace-detection.md", "source_location": "Step 6a", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Relay verbatim and tell the user to run git submodule update --init --recursive, because reverse-engineering needs the code on disk. Advisory only: do not run the command and do not block auto-proceed."}], "edges": [{"source": "_claude_aidlc_common_stages_initialization_workspace_detection", "target": "_claude_aidlc_common_stages_initialization_workspace_scaffold", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/aidlc-common/stages/initialization/workspace-detection.md", "source_location": "requires_stage", "weight": 1}, {"source": "_claude_aidlc_common_stages_initialization_workspace_detection", "target": "_claude_aidlc_common_stages_initialization_workspace_detection_nested_project_fallback", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/aidlc-common/stages/initialization/workspace-detection.md", "source_location": "Step 2", "weight": 1}, {"source": "_claude_aidlc_common_stages_initialization_workspace_detection", "target": "_claude_aidlc_common_stages_initialization_workspace_detection_brownfield_classification", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/aidlc-common/stages/initialization/workspace-detection.md", "source_location": "Step 3", "weight": 1}, {"source": "_claude_aidlc_common_stages_initialization_workspace_detection", "target": "_claude_aidlc_common_stages_initialization_workspace_detection_greenfield_classification", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/aidlc-common/stages/initialization/workspace-detection.md", "source_location": "Step 3", "weight": 1}, {"source": "_claude_aidlc_common_stages_initialization_workspace_detection", "target": "_claude_aidlc_common_stages_initialization_workspace_detection_submodule_warning_relay", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/aidlc-common/stages/initialization/workspace-detection.md", "source_location": "Step 6a", "weight": 1}, {"source": "_claude_aidlc_common_stages_initialization_workspace_detection_nested_project_fallback", "target": "_claude_aidlc_common_stages_initialization_workspace_detection_greenfield_classification", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/aidlc-common/stages/initialization/workspace-detection.md", "source_location": "Step 2", "weight": 1}, {"source": "_claude_aidlc_common_stages_initialization_workspace_detection_brownfield_classification", "target": "_claude_aidlc_common_stages_initialization_workspace_detection_submodule_warning_relay", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".claude/aidlc-common/stages/initialization/workspace-detection.md", "source_location": "Step 3 and Step 6a", "weight": 1}], "hyperedges": []}