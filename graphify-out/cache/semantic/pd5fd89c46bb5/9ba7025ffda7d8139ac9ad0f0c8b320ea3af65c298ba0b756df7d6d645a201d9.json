{"nodes": [{"id": "_claude_claude_aidlc", "label": "AI-DLC (AI-Driven Development Life Cycle)", "file_type": "concept", "source_file": ".claude/CLAUDE.md", "source_location": "## AI-DLC Structure", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Work advances idea-to-code in ordered steps that each stop at a human approval gate, so nothing advances without the user's say-so and the plan, depth, and direction stay changeable at any gate."}, {"id": "_claude_claude_stage_graph", "label": "Compiled stage graph (stage-graph.json)", "file_type": "concept", "source_file": ".claude/CLAUDE.md", "source_location": "## Plugins", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AI-DLC is open-world (plugins add stages, scopes, agents), so a compiled artefact plus /aidlc --doctor is the authoritative live view of what is enabled rather than any prose count."}, {"id": "_claude_claude_five_layer_rule_chain", "label": "Strict-additive five-layer rule chain (org to team to project to phase to stage)", "file_type": "rationale", "source_file": ".claude/CLAUDE.md", "source_location": "## AI-DLC Structure, Method/rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Method files are authored once at the workspace root and imported by reference, never copied, so every harness reads one hand-editable source of truth; narrower layers may only add specialisation, and a contradiction with broader policy is rejected at the learning admission check before it reaches disk."}, {"id": "_claude_claude_sensors", "label": "Sensors subsystem (report, never block)", "file_type": "concept", "source_file": ".claude/CLAUDE.md", "source_location": "## AI-DLC Structure, Sensors", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Automatic checks run against what gets written but only report; stages pull the sensors they want via a frontmatter import resolved at compile time, so the check set is declared per stage rather than globally enforced."}, {"id": "_claude_claude_intent_record_dir", "label": "Per-intent record dir convention", "file_type": "concept", "source_file": ".claude/CLAUDE.md", "source_location": "## Conventions", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_claude_aidlc_orchestrate", "label": "aidlc-orchestrate.ts (next, continue, report, park)", "file_type": "concept", "source_file": ".claude/CLAUDE.md", "source_location": "## AI-DLC Structure, Tools", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The parts that must be exact rather than judged (where the workflow is, the decision log, what runs next) live in deterministic CLI tools instead of LLM prose."}, {"id": "_claude_claude_stage_runner_skills", "label": "Stage-runner skills and --single isolated mode", "file_type": "concept", "source_file": ".claude/CLAUDE.md", "source_location": "## AI-DLC Structure, Stage-runner skills", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single-stage run is isolated by design and the tool refuses to advance the main workflow, so running one stage for its own sake cannot corrupt the main Current Stage pointer."}, {"id": "_claude_claude_session_resumption", "label": "Session resumption from active-intent cursor", "file_type": "concept", "source_file": ".claude/CLAUDE.md", "source_location": "## Session Resumption", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_claude_tec_governance_overlay", "label": "TEC_Project governance overlay", "file_type": "concept", "source_file": ".claude/CLAUDE.md", "source_location": "## TEC_Project governance overlay", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AI-DLC approval and TEC governance are deliberately separate: AI-DLC may declare a stage complete, but only the human student/supervisor may accept the TEC gate after reading the governance report, and a FAIL or NOT REVIEWABLE verdict forbids approving, advancing, or mutating the artifact."}, {"id": "_claude_claude_plugins", "label": "Open-world plugin model", "file_type": "concept", "source_file": ".claude/CLAUDE.md", "source_location": "## Plugins", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_claude_claude_aidlc", "target": "_claude_claude_five_layer_rule_chain", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/CLAUDE.md", "source_location": "## AI-DLC Structure, Method/rules", "weight": 1.0}, {"source": "_claude_claude_aidlc", "target": "_claude_claude_stage_graph", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/CLAUDE.md", "source_location": "## Plugins", "weight": 1.0}, {"source": "_claude_claude_aidlc", "target": "_claude_claude_sensors", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/CLAUDE.md", "source_location": "## AI-DLC Structure, Sensors", "weight": 1.0}, {"source": "_claude_claude_aidlc", "target": "_claude_claude_aidlc_orchestrate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/CLAUDE.md", "source_location": "## AI-DLC Structure, Tools", "weight": 1.0}, {"source": "_claude_claude_aidlc", "target": "_claude_claude_intent_record_dir", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/CLAUDE.md", "source_location": "## Conventions", "weight": 1.0}, {"source": "_claude_claude_plugins", "target": "_claude_claude_stage_graph", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/CLAUDE.md", "source_location": "## Plugins", "weight": 1.0}, {"source": "_