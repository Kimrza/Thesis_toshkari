{"nodes": [{"id": "_claude_knowledge_aidlc_aws_platform_agent_infrastructure_guide", "label": "Infrastructure Guide", "file_type": "document", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/infrastructure-guide.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_knowledge_aidlc_aws_platform_agent_infrastructure_guide_iac_tool_selection", "label": "IaC Tool Selection", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/infrastructure-guide.md", "source_location": "IaC Tool Selection", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CDK for AWS-native TypeScript/Python teams accepting lock-in, Terraform for multi-cloud accepting state-management complexity, CloudFormation when CDK is overkill, Pulumi for polyglot teams, Docker Compose for local development only - never production orchestration."}, {"id": "_claude_knowledge_aidlc_aws_platform_agent_infrastructure_guide_standard_pipeline_stages", "label": "Standard CI/CD Pipeline Stages", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/infrastructure-guide.md", "source_location": "CI/CD Pipeline Design", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fourteen ordered stages each with a time budget so the pipeline fails fast: lint under 30s, build under 2 min, unit tests under 3 min, SAST blocking on high/critical, E2E on critical paths only with flaky tests quarantined rather than skipped, and artifacts tagged with the commit SHA."}, {"id": "_claude_knowledge_aidlc_aws_platform_agent_infrastructure_guide_deployment_strategies", "label": "Deployment Strategy Selection", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/infrastructure-guide.md", "source_location": "Deployment Strategies", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blue-green buys instant rollback for double infrastructure cost and schema-sync complexity; canary limits blast radius but needs traffic splitting and automated metric comparison; rolling needs no extra infrastructure but runs mixed versions and rolls back slower; recreate is simplest but takes downtime."}, {"id": "_claude_knowledge_aidlc_aws_platform_agent_infrastructure_guide_four_pillars_observability", "label": "Four Pillars of Observability", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/infrastructure-guide.md", "source_location": "Monitoring and Observability Stack", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Metrics (RED for services, USE for resources), structured JSON logs with traceId and tiered retention, traces across services, and alerts on symptoms such as error rate rather than causes such as CPU - with a runbook link in every alert and P1/P2/P3 severity routing."}, {"id": "_claude_knowledge_aidlc_aws_platform_agent_infrastructure_guide_container_orchestration_checklist", "label": "Container Orchestration Checklist", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/infrastructure-guide.md", "source_location": "Container Orchestration Checklist", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pinned minimal base image, multi-stage build, health endpoint, SIGTERM draining, CPU/memory limits against noisy neighbours, secrets from a manager rather than the image or env vars, stdout/stderr logging, non-root user, read-only filesystem where possible."}, {"id": "_claude_knowledge_aidlc_aws_platform_agent_infrastructure_guide_environment_strategy", "label": "Environment Strategy and Parity Rules", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/infrastructure-guide.md", "source_location": "Environment Strategy", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local, ephemeral CI, persistent staging, full-scale production. Staging MUST reuse production IaC templates parameterized for scale and the same database engine and version, and SHOULD hold representative anonymized data volume - otherwise staging validates a system that does not exist."}], "edges": [{"source": "_claude_knowledge_aidlc_aws_platform_agent_infrastructure_guide", "target": "_claude_knowledge_aidlc_aws_platform_agent_infrastructure_guide_iac_tool_selection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-aws-platform-agent/infrastructure-guide.md", "source_location": "IaC Tool Selection", "weight": 1}, {"source": "_claude_knowledge_aidlc_aws_platform_agent_infrastructure_guide", "target": "_claude_knowledge_aidlc_aws_platform_agent_infrastructure_guide_standard_pipeline_stages", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-aws-platform-agent/infrastructure-guide.md", "source_location": "CI/CD Pipeline Design", "weight": 1}, {"source": "_claude_knowledge_aidlc_aws_platform_agent_infrastructure_guide", "target": "_claude_knowledge_aidlc_aws_platform_agent_infrastructure_guide_deployment_strategies", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-aws-platform-agent/infrastructure-guide.md", "source_location": "Deployment Strategies", "weight": 1}, {"source": "_claude_knowledge_aidlc_aws_platform_agent_infrastructure_guide", "target": "_claude_knowledge_aidlc_aws_platform_agent_infrastructure_guide_four_pillars_observability", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-aws-platform-agent/infrastructure-guide.md", "source_location": "Monitoring and Observability Stack", "weight": 1}, {"source": "_claude_knowledge_