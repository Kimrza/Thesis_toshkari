{"nodes": [{"id": "_claude_skills_review_tec_governance_skill_review_tec_governance", "label": "Review TEC Governance Skill", "file_type": "document", "source_file": ".claude/skills/review-tec-governance/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_review_tec_governance_skill_authority_precedence_order", "label": "Authority Precedence Order", "file_type": "concept", "source_file": ".claude/skills/review-tec-governance/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vision normative core outranks Technical Environment, which outranks freeze decisions and change records, then AI-DLC stage artifacts, then code/tests/manifests/measured outputs, with reviewer inference last. A Vision/Technical Environment conflict is a blocking finding and is never resolved by inference."}, {"id": "_claude_skills_review_tec_governance_skill_adaptive_mode", "label": "Adaptive Review Mode", "file_type": "concept", "source_file": ".claude/skills/review-tec-governance/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_review_tec_governance_skill_full_board_mode", "label": "Full-Board Review Mode", "file_type": "concept", "source_file": ".claude/skills/review-tec-governance/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mandatory for G-05, G-06, G-P2, G-P3, any locked-test action, phase-transition or protected-hash review, final reproducibility, model advancement, release, and claims; adaptive escalates to it on suspected leakage, unauthorized December access, protocol drift, target-lineage ambiguity, license incompatibility, or a claims-boundary breach."}, {"id": "_claude_skills_review_tec_governance_skill_gate_verdict", "label": "Gate Verdict", "file_type": "concept", "source_file": ".claude/skills/review-tec-governance/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exactly one of PASS, CONDITIONAL PASS, FAIL, or NOT REVIEWABLE. CONDITIONAL PASS is barred for an unresolved P0 freeze, missing supervisor approval, unauthorized locked-test access, IRI leakage, protected-hash drift, target-definition ambiguity, or missing primary evidence; NOT REVIEWABLE is returned rather than reviewing around absent authority or evidence."}, {"id": "_claude_skills_review_tec_governance_skill_model_advancement_decision", "label": "Model Advancement Decision", "file_type": "concept", "source_file": ".claude/skills/review-tec-governance/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Issued separately from the process verdict because project completion is not model success: a correctly executed negative or inconclusive experiment can pass a process gate while DO NOT ADVANCE blocks promotion of the model or a positive claim."}, {"id": "_claude_skills_review_tec_governance_skill_independent_evidence_pass", "label": "Independent Evidence Passes", "file_type": "concept", "source_file": ".claude/skills/review-tec-governance/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every active reviewer gets the same artifact set and no other reviewer's conclusions before their pass completes, so findings are genuinely independent rather than anchored."}, {"id": "_claude_skills_review_tec_governance_skill_finding_requirements", "label": "Finding Content Requirements", "file_type": "concept", "source_file": ".claude/skills/review-tec-governance/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each finding must carry a stable ID, cited evidence path, observed fact versus requirement, severity, affected gate and stage, consequence, smallest acceptable remediation, and the verification that closes it; unsupported criticism, invented scientific values, and generic best-practice or style-only findings are rejected."}, {"id": "_claude_skills_review_tec_governance_skill_read_only_overlay", "label": "Read-Only Governance Overlay", "file_type": "rationale", "source_file": ".claude/skills/review-tec-governance/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The board reviews and recommends: it does not implement fixes, rewrite approved artifacts, open protected data, approve academic gates, or alter AI-DLC state, and it stops after the recommendation for a human decision."}], "edges": [{"source": "_claude_skills_review_tec_governance_skill_review_tec_governance", "target": "_claude_skills_review_tec_governance_references_gate_map_gate_map", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/review-tec-governance/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_review_tec_governance_skill_review_tec_governance", "target": "_claude_skills_review_tec_governance_references_review_board_review_board", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/review-tec-governance/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_review_tec_governance_skill_review_tec_governance", "target": "_claude_skills_review_tec_governance_references_review_criteria_review_criteria", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/review-tec-governance/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_review_tec_governance_skill_review_tec_governance", "target": "_claude_skills_review_tec_governanc