{"nodes": [{"id": "_claude_knowledge_aidlc_aws_platform_agent_cdk_best_practices", "label": "AWS CDK Best Practices", "file_type": "document", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/cdk-best-practices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_knowledge_aidlc_aws_platform_agent_cdk_best_practices_construct_levels", "label": "CDK Construct Levels (L1/L2/L3)", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/cdk-best-practices.md", "source_location": "Construct Levels", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "L2 is preferred because it encodes AWS best practices as defaults and adds grant helpers; L1 only when L2 hides a needed property; L3 only when the pattern fits exactly - significant customization means dropping back to L2."}, {"id": "_claude_knowledge_aidlc_aws_platform_agent_cdk_best_practices_props_interface_pattern", "label": "Props Interface Pattern", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/cdk-best-practices.md", "source_location": "Construct Design Patterns", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dependencies arrive via readonly props rather than being created inside the construct, and props are typed as interfaces (IVpc, ITable) rather than concrete types because that is what enables cross-stack references. Outputs are exposed as public readonly for consuming constructs."}, {"id": "_claude_knowledge_aidlc_aws_platform_agent_cdk_best_practices_stack_organization", "label": "Stack Organization by Lifecycle", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/cdk-best-practices.md", "source_location": "Stack Organization", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resources that change together share a stack; stateful resources (databases, buckets) are separated from stateless compute because stateful stacks change rarely while stateless stacks deploy frequently. Cross-stack references are used sparingly since they create deployment coupling."}, {"id": "_claude_knowledge_aidlc_aws_platform_agent_cdk_best_practices_environment_aware_stacks", "label": "Environment-Aware Stacks", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/cdk-best-practices.md", "source_location": "Environment-Aware Stacks", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One codebase for all environments with differences parameterized through context-driven config; account IDs and regions are never hardcoded, and production stacks must declare an explicit account and region rather than relying on ambient defaults."}, {"id": "_claude_knowledge_aidlc_aws_platform_agent_cdk_best_practices_cdk_testing", "label": "CDK Assertion and Snapshot Testing", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/cdk-best-practices.md", "source_location": "CDK Testing", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fine-grained assertions cover security properties, critical configuration and resource counts; snapshots catch regressions and make infrastructure diffs reviewable in pull requests. CDK internals and CloudFormation implementation details are explicitly not tested."}, {"id": "_claude_knowledge_aidlc_aws_platform_agent_cdk_best_practices_security_defaults", "label": "CDK Security Defaults", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/cdk-best-practices.md", "source_location": "Security Defaults", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Encryption on S3/DynamoDB/SQS/EBS, BLOCK_ALL public access, authorization on every API route, access and execution logging with explicit retention, and least privilege expressed through grant helpers rather than hand-written wildcard IAM policies."}, {"id": "_claude_knowledge_aidlc_aws_platform_agent_cdk_best_practices_cdk_aspects_for_compliance", "label": "CDK Aspects for Compliance", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/cdk-best-practices.md", "source_location": "CDK Aspects for Compliance", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An Aspect visits every construct in the tree and can validate, warn, or modify - so compliance checks (bucket encryption, PITR, reserved concurrency, no 0.0.0.0/0 ingress, mandatory cost tags) run at synthesis time across the whole app rather than per-stack by hand."}], "edges": [{"source": "_claude_knowledge_aidlc_aws_platform_agent_cdk_best_practices", "target": "_claude_knowledge_aidlc_aws_platform_agent_cdk_best_practices_construct_levels", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-aws-platform-agent/cdk-best-practices.md", "source_location": "Construct Levels", "weight": 1}, {"source": "_claude_knowledge_aidlc_aws_platform_agent_cdk_best_practices", "target": "_claude_knowledge_aidlc_aws_platform_agent_cdk_best_practices_props_interface_pattern", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-aws-platform-agent/cdk-best-practices.md", "source_location": "Construct Design Patterns", "weight": 1}, {"source": "_claude_knowledge_aidlc_aws_platform_agent_cdk_best_practices", "target": "_claude_knowledge_aidlc_aws_platform_agent_cdk_best_practices_stack_organization", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-aws-platform-agent/cdk-best-practices.md", "source_location": "Stack Organization", "weight": 1}, {"source": "_claude_knowledge_aidlc_aws_platform_agent_cdk_best_practices", "target": "_claude_knowledge_aidlc_aws_platform_agent_cdk_best_practices_environment_aware_stacks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-aws-platform-agent/cdk-best-practices.md", "source_location": "Environment-Aware Stacks", "weight": 1}, {"source": "_claude_knowledge_aidlc_aws_platform_agent_cdk_best_practices", "target": "_claude_knowledge_aidlc_aws_platform_agent_cdk_best_practices_cdk_testing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-aws-platform-agent/cdk-best-practices.md", "source_location": "CDK Testing", "weight": 1}, {"source": "_claude_knowledge_aidlc_aws_platform_agent_cdk_best_practices", "target": "_claude_knowledge_aidlc_aws_platform_agent_cdk_best_practices_security_defaults", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-aws-platform-agent/cdk-best-practices.md", "source_location": "Security Defaults", "weight": 1}, {"source": "_claude_knowledge_aidlc_aws_platform_agent_cdk_best_practices", "target": "_claude_knowledge_aidlc_aws_platform_agent_cdk_best_practices_cdk_aspects_for_compliance", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-aws-platform-agent/cdk-best-practices.md", "source_location": "CDK Aspects for Compliance", "weight": 1}, {"source": "_claude_knowledge_aidlc_aws_platform_agent_cdk_best_practices_security_defaults", "target": "_claude_knowledge_aidlc_aws_platform_agent_well_architected_framework_security", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".claude/knowledge/aidlc-aws-platform-agent/cdk-best-practices.md", "source_location": "Security Defaults", "weight": 1}, {"source": "_claude_knowledge_aidlc_aws_platform_agent_cdk_best_practices_cdk_asp