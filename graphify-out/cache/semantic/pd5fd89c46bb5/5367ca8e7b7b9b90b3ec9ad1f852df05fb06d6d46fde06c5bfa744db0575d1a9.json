{"nodes": [{"id": "_claude_skills_caveman_compress_security_snyk_false_positive", "label": "Snyk High-Risk Rating False Positive", "file_type": "rationale", "source_file": ".claude/skills/caveman-compress/SECURITY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The High Risk rating comes from static-analysis heuristics firing on subprocess plus file read/write patterns. The skill does not execute file content as code, makes no network requests except to Anthropic's API, touches no path outside the user-provided file and its backup dir, and never uses shell=True or string interpolation."}, {"id": "_claude_skills_caveman_compress_security_subprocess_claude_cli_fallback", "label": "claude CLI Subprocess Fallback", "file_type": "concept", "source_file": ".claude/skills/caveman-compress/SECURITY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "subprocess.run() invokes the claude CLI only when ANTHROPIC_API_KEY is unset, using a fixed argument list with user file content passed on stdin rather than as a shell argument, so no shell interpolation can occur."}, {"id": "_claude_skills_caveman_compress_security_file_size_limit", "label": "500KB File Size Limit", "file_type": "concept", "source_file": ".claude/skills/caveman-compress/SECURITY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Files over 500KB are rejected before any API call is made, so an oversized input cannot become an unbounded request."}, {"id": "_claude_skills_caveman_compress_security_auth_behavior", "label": "Dual Auth Path (SDK or CLI)", "file_type": "concept", "source_file": ".claude/skills/caveman-compress/SECURITY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With ANTHROPIC_API_KEY set the skill uses the Anthropic Python SDK directly and spawns no subprocess; without it, it falls back to the claude CLI and reuses the user's existing desktop authentication."}], "edges": [{"source": "_claude_skills_caveman_compress_security_snyk_false_positive", "target": "_claude_skills_caveman_compress_skill_caveman_compress", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/caveman-compress/SECURITY.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_caveman_compress_security_subprocess_claude_cli_fallback", "target": "_claude_skills_caveman_compress_security_snyk_false_positive", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/caveman-compress/SECURITY.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_caveman_compress_security_auth_behavior", "target": "_claude_skills_caveman_compress_security_subprocess_claude_cli_fallback", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/caveman-compress/SECURITY.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_caveman_compress_security_file_size_limit", "target": "_claude_skills_caveman_compress_skill_caveman_compress", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/caveman-compress/SECURITY.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_caveman_compress_security_snyk_false_positive", "target": "_claude_skills_caveman_compress_skill_out_of_tree_backup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/caveman-compress/SECURITY.md", "source_location": null, "weight": 1.0}], "hyperedges": []}