{"nodes": [{"id": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_decisions_decisions", "label": "Architecture Decisions (ADR-01 to ADR-10)", "file_type": "document", "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_decisions_adr_01", "label": "ADR-01 - Method-surface depth: signatures at package boundaries only", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Specifying everything risks rework and specifying nothing leaves units-generation with no contract to cut unit boundaries along; the leakage and phase-boundary contracts are the ones expressible as shapes."}, {"id": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_decisions_adr_02", "label": "ADR-02 - Phase 1 import prohibition enforced at run time", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The rejected alternative, an import-time raise inside src/gnss/rinex.py, cannot be bypassed by forgetting a call but inverts the dependency by making a Phase 2 module conditional on Phase 1 state and needs the active phase discoverable at import time."}, {"id": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_decisions_adr_03", "label": "ADR-03 - Two locked-test guards, deliberately separate", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The access log was found incomplete because non-execution reads had no requirement (VAL-2), and the coverage audit is required before G-05 while the metrics run is barred until after it."}, {"id": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_decisions_adr_04", "label": "ADR-04 - Experiment registry: append-only JSONL, derived CSV", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removing a failed run's line would require rewriting a file nothing rewrites, so visibility of failed and aborted runs holds by construction rather than by discipline."}, {"id": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_decisions_adr_05", "label": "ADR-05 - Determinism centralised, with the bootstrap seed carved out", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Centralising puts the applied seeds in the per-run environment lock automatically; the bootstrap seed stays separately owned so a model reseed can never change a bootstrap draw."}, {"id": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_decisions_adr_06", "label": "ADR-06 - A new src/data/config.py rather than widening an existing module", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Section 12's stated per-module responsibilities are what the release and phase-boundary tests key on, so widening a module to host config loading would weaken those tests."}, {"id": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_decisions_adr_07", "label": "ADR-07 - Platform differences resolved at runtime, never in the governed configs", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeping machine paths out of the four governed configs means moving a directory never changes a governed hash and never trips the exact-equality check."}, {"id": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_decisions_adr_08", "label": "ADR-08 - PYTHONHASHSEED enforced by re-exec and in the documented sequence", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The re-exec makes the guarantee hold for a directly invoked script, and amending the documented sequence keeps the text a reader follows identical to what is enforced."}, {"id": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_decisions_adr_09", "label": "ADR-09 - Phase 2 gets a governed boundary, not a designed interior", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Designing Phase 2 internals now would freeze a contract against a target-definition that D-17 already had to redefine on measured evidence."}, {"id": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_decisions_adr_10", "label": "ADR-10 - The four-part section 12/13.2 amendment recorded as an obligation", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A tree amendment is a supervisor-owned change, so it is recorded rather than applied; until it is signed, three modules and one test module in this design have no authority backing and code-generation must not create them."}, {"id": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_decisions_finding_1_three_seed_mean", "label": "Review finding 1 (Major) - three_seed_mean cannot check the frozen seed set", "file_type": "concept", "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_decisions_finding_2_fit_transforms_claim", "label": "Review finding 2 (Major) - the fit/apply split does not make full-dataset fitting unrepresentable", "file_type": "concept", "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_decisions_finding_3_req_eng_4_count", "label": "Review finding 3 (Major) - ADR-10 names citations that do not carry the count claimed", "file_type": "concept", "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_decisions_decisions", "target": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_decisions_adr_01", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/decisions.md", "source_location": null, "weight": 1}, {"source": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_decisions_decisions", "target": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_decisions_adr_02", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/decisions.md", "source_location": null, "weight": 1}, {"source": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_decisions_decisions", "target": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_decisions_adr_03", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/decisions.md", "source_location": null, "weight": 1}, {"source": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_decisions_decisions", "target": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_decisions_adr_04", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "aidlc/spaces/default/intents