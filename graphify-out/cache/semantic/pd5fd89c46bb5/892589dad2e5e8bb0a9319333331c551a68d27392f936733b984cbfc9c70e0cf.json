{"nodes": [{"id": "_claude_skills_graphify_references_github_and_merge_cross_repo_merge", "label": "Cross-Repo Graph Merge", "file_type": "concept", "source_file": ".claude/skills/graphify/references/github-and-merge.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each repo is built separately then merged with merge-graphs; every node carries a repo attribute so the merged graph can be filtered by origin, and clones are reused on repeat runs."}, {"id": "_claude_skills_graphify_references_github_and_merge_monorepo_subfolder_extraction", "label": "Monorepo Subfolder Extraction", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/github-and-merge.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The skill pipeline always writes to graphify-out/ in the cwd, so running it per subfolder would clobber the same output dir; the CLI is used instead because it places graphify-out/ inside each scanned path before the root-level merge."}], "edges": [{"source": "_claude_skills_graphify_references_github_and_merge_cross_repo_merge", "target": "_claude_skills_graphify_references_github_and_merge_monorepo_subfolder_extraction", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/github-and-merge.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_references_github_and_merge_monorepo_subfolder_extraction", "target": "_claude_skills_graphify_skill_fast_path_existing_graph", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/github-and-merge.md", "source_location": null, "weight": 1.0}], "hyperedges": []}