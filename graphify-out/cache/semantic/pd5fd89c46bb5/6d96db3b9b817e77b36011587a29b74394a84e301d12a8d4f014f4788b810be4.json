{"nodes": [{"id": "_claude_skills_aidlc_bugfix_skill_aidlc_orchestrate_engine", "label": "aidlc-orchestrate.ts Engine CLI", "file_type": "concept", "source_file": ".claude/skills/aidlc-bugfix/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every skill in this family is a thin shell over the same engine binary: the engine owns all routing (next / report), so a skill never decides what runs next."}, {"id": "_claude_skills_aidlc_bugfix_skill_deterministic_forwarding_loop", "label": "Deterministic Forwarding Loop", "file_type": "rationale", "source_file": ".claude/skills/aidlc-bugfix/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "next, act on directive.kind (run-stage / ask / print / error / done), report, repeat until kind == done. Kept deterministic so the conductor never invents routing; the engine stays the single source of truth for stage order."}, {"id": "_claude_skills_aidlc_bugfix_skill_conductor_persona_delivery", "label": "Engine-Delivered Conductor Persona", "file_type": "rationale", "source_file": ".claude/skills/aidlc-bugfix/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The conductor persona arrives on the first directive conductor_persona field and is adopted for the whole run; skills are explicitly told not to load it by hand so persona selection cannot drift from engine state."}, {"id": "_claude_skills_aidlc_bugfix_skill_stage_protocol_reference", "label": "Stage Protocol (aidlc-common/protocols/stage-protocol.md)", "file_type": "document", "source_file": ".claude/skills/aidlc-bugfix/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_aidlc_bugfix_skill_state_file_scope_precedence", "label": "State-File Scope Precedence", "file_type": "rationale", "source_file": ".claude/skills/aidlc-bugfix/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The --scope baked into a scope-runner skill only seeds a fresh workflow; the scope in the state file always wins on an existing workflow, so re-invoking a runner resumes rather than re-scopes."}, {"id": "_claude_skills_aidlc_bugfix_skill_opt_in_packaging", "label": "Opt-In Packaging (No Second Entry Point)", "file_type": "rationale", "source_file": ".claude/skills/aidlc-bugfix/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each runner skill is packaging over a flag on /aidlc, never an alternate entry point: the underlying invocation works without the skill, so the skill set can grow without multiplying engine doors."}, {"id": "_claude_skills_aidlc_bugfix_skill_aidlc_runner_gen", "label": "aidlc-runner-gen Generator", "file_type": "concept", "source_file": ".claude/skills/aidlc-bugfix/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Declared as generated-by in every skill frontmatter in this chunk; the runner set is generated from the compiled stage graph, so adding a stage file and regenerating adds its runner."}, {"id": "_claude_skills_aidlc_bugfix_skill_aidlc_bugfix", "label": "aidlc-bugfix Scope Runner Skill", "file_type": "document", "source_file": ".claude/skills/aidlc-bugfix/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fix a specific bug"}], "edges": [{"source": "_claude_skills_aidlc_bugfix_skill_aidlc_bugfix", "target": "_claude_skills_aidlc_bugfix_skill_aidlc_orchestrate_engine", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/skills/aidlc-bugfix/SKILL.md", "source_location": null, "