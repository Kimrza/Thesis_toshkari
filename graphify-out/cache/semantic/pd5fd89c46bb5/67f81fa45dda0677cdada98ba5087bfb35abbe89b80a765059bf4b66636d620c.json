{"nodes": [{"id": "_claude_skills_review_tec_governance_references_review_criteria_review_criteria", "label": "TEC Review Criteria", "file_type": "document", "source_file": ".claude/skills/review-tec-governance/references/review-criteria.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_review_tec_governance_references_review_criteria_immediate_blockers", "label": "Immediate Blockers", "file_type": "concept", "source_file": ".claude/skills/review-tec-governance/references/review-criteria.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_review_tec_governance_references_review_criteria_iri_free_ml_boundary", "label": "IRI-Free ML Boundary", "file_type": "concept", "source_file": ".claude/skills/review-tec-governance/references/review-criteria.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No IRI value, residual, target, transformation or derived field may reach ML training or inference, and IRI/GIM modules must not be imported into feature or model code - they are joined only at evaluation time."}, {"id": "_claude_skills_review_tec_governance_references_review_criteria_locked_test_hash_before_metrics", "label": "Locked-Test Access And Hash-Before-Metrics", "file_type": "concept", "source_file": ".claude/skills/review-tec-governance/references/review-criteria.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "December 2022 performance may not be accessed before G-05, predictions are written once and never regenerated or overwritten, and the prediction hash precedes any metric."}, {"id": "_claude_skills_review_tec_governance_references_review_criteria_comparison_wide_mask", "label": "Comparison-Wide Mask Fairness", "file_type": "concept", "source_file": ".claude/skills/review-tec-governance/references/review-criteria.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pairwise or model-specific masks let models sit different exams, so one comparison-wide mask with equal eligible information and matched windows is required."}, {"id": "_claude_skills_review_tec_governance_references_review_criteria_vector_time_block_bootstrap", "label": "Vector Time-Block Bootstrap", "file_type": "concept", "source_file": ".claude/skills/review-tec-governance/references/review-criteria.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "10,000 24-hour vector block replicates carrying all stations together, a 48-hour sensitivity, and a reported cross-station paired-error correlation."}, {"id": "_claude_skills_review_tec_governance_references_review_criteria_paired_loss_estimand", "label": "Paired-Loss Estimand And Sign Convention", "file_type": "concept", "source_file": ".claude/skills/review-tec-governance/references/review-criteria.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IRI squared loss minus LSTM squared loss with equal-station weighting, so a positive value favours the model; a reversed or unstated sign is a blocker."}, {"id": "_claude_skills_review_tec_governance_references_review_criteria_model_advancement_test", "label": "Model Advancement Test", "file_type": "concept", "source_file": ".claude/skills/review-tec-governance/references/review-criteria.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ADVANCE requires all six conditions on frozen evidence, including improvement over persistence on the same mask, co-reported seasonal persistence and climatology, no single-station-driven gain, and interpretation against the target uncertainty budget. A valid DO NOT ADVANCE may still receive a process-gate PASS."}, {"id": "_claude_skills_review_tec_governance_references_review_criteria_reproducibility_implementation_checks", "label": "Reproducibility And Implementation Checks", "file_type": "concept", "source_file": ".claude/skills/review-tec-governance/references/review-criteria.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Python 3.11 exact pins, per-run environment capture, local and Kaggle evidence, a complete CPU path, exactly four governed configs, both fixtures, and critical negative-path tests; the seven-day LSTM fixture is a smoke test, never scientific evidence."}, {"id": "_claude_skills_review_tec_governance_references_review_criteria_severity_guide", "label": "Severity Guide", "file_type": "concept", "source_file": ".claude/skills/review-tec-governance/references/review-criteria.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_review_tec_governance_references_review_criteria_claim_boundary", "label": "Approved Claim Boundary", "file_type": "concept", "source_file": ".claude/skills/review-tec-governance/references/review-criteria.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any geographic, operational, positioning, commercial, multi-year, or arbitrary-location claim exceeding the approved three-station 2022 +1-hour boundary is a blocker."}], "edges": [{"source": "_claude_skills_review_tec_governance_references_review_criteria_review_criteria", "target": "_claude_skills_review_tec_governance_references_review_criteria_immediate_blockers", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/review-tec-governance/references/review-criteria.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_review_tec