{"nodes": [{"id": "_claude_skills_caveman_review_skill_caveman_review", "label": "Caveman Review Skill", "file_type": "document", "source_file": ".claude/skills/caveman-review/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_caveman_review_skill_one_line_comment_format", "label": "One-Line Review Comment Format", "file_type": "concept", "source_file": ".claude/skills/caveman-review/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each finding compresses to location, problem, fix so the actionable signal survives and the reviewer is not made to re-read what the diff already shows."}, {"id": "_claude_skills_caveman_review_skill_severity_prefix", "label": "Review Severity Prefix Taxonomy", "file_type": "concept", "source_file": ".claude/skills/caveman-review/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "bug/risk/nit/q prefixes replace hedging prose: 'nit' carries the 'just a suggestion' meaning in four characters and 'q' carries genuine uncertainty, so terseness never turns into false confidence."}, {"id": "_claude_skills_caveman_review_skill_auto_clarity", "label": "Auto-Clarity Escape Hatch", "file_type": "rationale", "source_file": ".claude/skills/caveman-review/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Terse mode is dropped for security findings, architectural disagreements, and onboarding contexts because CVE-class bugs and design arguments need the rationale, not a one-liner; compression resumes afterwards."}, {"id": "_claude_skills_caveman_review_skill_boundaries", "label": "Caveman Review Boundaries", "file_type": "concept", "source_file": ".claude/skills/caveman-review/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reviews only: it does not write the fix, does not approve or request changes, and does not run linters, so the skill cannot silently take an authoring or gatekeeping action."}], "edges": [{"source": "_claude_skills_caveman_review_skill_caveman_review", "target": "_claude_skills_caveman_review_skill_one_line_comment_format", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/caveman-review/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_caveman_review_skill_caveman_review", "target": "_claude_skills_caveman_review_skill_severity_prefix", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/caveman-review/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_caveman_review_skill_caveman_review", "target": "_claude_skills_caveman_review_skill_auto_clarity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/caveman-review/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_caveman_review_skill_caveman_review", "target": "_claude_skills_caveman_review_skill_boundaries", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/caveman-review/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_caveman_review_skill_auto_clarity", "target": "_claude_skills_caveman_review_skill_one_line_comment_format", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/caveman-review/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_caveman_review_skill_severity_prefix", "target": "_claude_skills_caveman_review_skill_one_line_comment_format", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "c