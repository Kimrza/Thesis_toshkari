{"nodes": [{"id": "_claude_knowledge_aidlc_developer_agent_data_modelling_patterns", "label": "Data Modelling Patterns", "file_type": "document", "source_file": ".claude/knowledge/aidlc-developer-agent/data-modelling-patterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_knowledge_aidlc_developer_agent_data_modelling_patterns_relational_vs_nosql", "label": "Relational vs NoSQL Selection", "file_type": "rationale", "source_file": ".claude/knowledge/aidlc-developer-agent/data-modelling-patterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Relational for complex reporting, ad-hoc queries and multi-table transactions; DynamoDB for well-defined access patterns and single-digit-ms latency at any scale."}, {"id": "_claude_knowledge_aidlc_developer_agent_data_modelling_patterns_normalization_forms", "label": "Normalization Forms (1NF to BCNF)", "file_type": "rationale", "source_file": ".claude/knowledge/aidlc-developer-agent/data-modelling-patterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Normalize to 3NF for transactional systems and denormalize selectively for read-heavy workloads."}, {"id": "_claude_knowledge_aidlc_developer_agent_data_modelling_patterns_dynamodb_single_table_design", "label": "DynamoDB Single-Table Design", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-developer-agent/data-modelling-patterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multiple entity types in one table using overloaded partition and sort keys with prefixes."}, {"id": "_claude_knowledge_aidlc_developer_agent_data_modelling_patterns_access_pattern_first", "label": "Access-Pattern-First Design Process", "file_type": "rationale", "source_file": ".claude/knowledge/