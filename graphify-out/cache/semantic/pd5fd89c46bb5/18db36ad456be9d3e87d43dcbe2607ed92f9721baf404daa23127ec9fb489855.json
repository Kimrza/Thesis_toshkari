{"nodes": [{"id": "_claude_skills_graphify_references_query_constrained_query_expansion", "label": "Constrained Query Expansion", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The query CLI matches by case-folded substring plus IDF with no stemming, synonyms, or cross-language matching, so a vocabulary mismatch returns zero hits and the answer collapses to noise. The question is expanded only against tokens actually present in the graph's own label vocabulary - never invented - and the selection is printed so it is auditable; an empty selection stops the query instead of fabricating a search."}, {"id": "_claude_skills_graphify_references_query_bfs_dfs_traversal_modes", "label": "BFS And DFS Traversal Modes", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BFS answers 'what is X connected to' with nearest-neighbour breadth; DFS traces how X reaches Y along one chain and is depth-limited to 6 so it does not walk the whole graph."}, {"id": "_claude_skills_graphify_references_query_token_budget", "label": "Token Budget Ranked Output", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nodes are ranked by term overlap and the output is truncated at roughly four characters per token, so the most relevant subgraph survives the cap."}, {"id": "_claude_skills_graphify_references_query_networkx_fallback_traversal", "label": "Inline NetworkX Fallback Traversal", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used when the graphify query CLI is unavailable, matching nodes the same way the binary does so answers stay consistent."}, {"id": "_claude_skills_graphify_references_query_save_result_work_memory", "label": "save-result Work Memory Loop", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The answer, its cited nodes, and the expanded-token trace are written back so the next --update extracts the Q&A as a graph node, closing a self-improving feedback loop."}, {"id": "_claude_skills_graphify_references_query_lessons_reflection", "label": "LESSONS.md Reflection", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "reflect --if-stale is deterministic and LLM-free, and no-ops when LESSONS.md is already newer than every input, so a session-start refresh of preferred sources, known dead ends and prior corrections costs almost nothing."}, {"id": "_claude_skills_graphify_references_query_graphify_path", "label": "Graphify Path (Shortest Path)", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_references_query_graphify_explain", "label": "Graphify Explain (Node Neighbourhood)", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_claude_skills_graphify_references_query_constrained_query_expansion", "target": "_claude_skills_graphify_references_query_bfs_dfs_traversal_modes", "relation": "references", "confid