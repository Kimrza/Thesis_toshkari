{"nodes": [{"id": "_claude_skills_graphify_references_extraction_spec_extraction_subagent_prompt", "label": "Extraction Subagent Prompt", "file_type": "document", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_references_extraction_spec_node_id_format", "label": "Node ID Format Convention", "file_type": "concept", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full repo-relative path with every directory level kept, so same-named files in different directories stay distinct and the LLM id matches the AST extractor's id; filename-only or immediate-parent-only ids create orphan ghost duplicates. No chunk suffix, so the same entity is deterministic across chunks."}, {"id": "_claude_skills_graphify_references_extraction_spec_confidence_score_rubric", "label": "Confidence Score Rubric", "file_type": "concept", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five discrete values replace a continuous range because models follow discrete rubrics better: the observed bimodal production distribution (>50% at 0.5, >40% at 0.85+) showed range guidance being collapsed to a binary. Anything that fits none of them is marked AMBIGUOUS instead of scored below 0.4."}, {"id": "_claude_skills_graphify_references_extraction_spec_semantic_similarity_edge", "label": "Semantically Similar Edge", "file_type": "concept", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Links concepts that solve the same problem with no structural tie, reserved for genuinely non-obvious cross-cutting similarity so the graph is not flooded with trivial matches."}, {"id": "_claude_skills_graphify_references_extraction_spec_hyperedge", "label": "Hyperedge", "file_type": "concept", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used only when three or more nodes participate in a shared concept or flow that pairwise edges cannot express; capped at three per chunk."}, {"id": "_claude_skills_graphify_references_extraction_spec_source_file_rule", "label": "Verbatim source_file Rule", "file_type": "concept", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The subagent copies the FILE_LIST path character-for-character because the engine canonicalizes and relativizes downstream; this keeps a full build and an incremental --update on the same base so replace-on-re-extract matches the existing node instead of accumulating duplicates."}, {"id": "_claude_skills_graphify_references_extraction_spec_call_edge_direction_rule", "label": "Call Edge Direction And Language Rule", "file_type": "concept", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Caller is always the source and callee the target, and calls edges never cross languages because a cross-language call edge is a phantom artifact."}], "edges": [{"source": "_claude_skills_graphify_references_extraction_spec_extraction_subagent_prompt", "target": "_claude_skills_graphify_references_extraction_spec_node_id_format", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_references_extraction_spec_extraction_subagent_prompt", "target": "_claude_skills_graphify_references_extraction_spec_confidence_score_rubric", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_references_extraction_spec_extraction_subagent_prompt", "target": "_claude_skills_graphify_references_extraction_spec_semantic_similarity_edge", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_references_extraction_spec_extraction_subagent_prompt", "target": "_claude_skills_graphify_references_extraction_spec_hyperedge", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_references_extraction_spec_extraction_subagent_prompt", "target": "_claude_skills_graphify_references_extraction_spec_source_file_rule", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_references_extraction_spec_extraction_subagent_prompt", "target": "_claude_skills_graphify_references_extraction_spec_call_edge_direction_rule", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_references_extraction_spec_node_id_format", "target": "_claude_skil