th."}, {"id": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_requirements_analysis_memory_chair_03_conflicted_board", "label": "CHAIR-03 - the board chair had materially changed the artifact it reviewed", "file_type": "concept", "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/requirements-analysis/memory.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_requirements_analysis_memory_memory", "target": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_requirements_analysis_memory_remediation_defect_reintroduction_pattern", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/requirements-analysis/memory.md", "source_location": null, "weight": 1}, {"source": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_requirements_analysis_memory_memory", "target": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_requirements_analysis_memory_framework_path_case_deadlock", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/requirements-analysis/memory.md", "source_location": null, "weight": 1}, {"source": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_requirements_analysis_memory_memory", "target": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_requirements_analysis_memory_chair_03_conflicted_board", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/requirements-analysis/memory.md", "source_location": null, "weight": 1}, {"source": "aidlc_spaces_default_intents_260813_tec_hourly