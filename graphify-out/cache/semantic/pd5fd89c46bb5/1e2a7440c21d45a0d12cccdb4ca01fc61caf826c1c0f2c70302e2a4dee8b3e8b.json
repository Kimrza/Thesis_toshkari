{"nodes": [{"id": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns", "label": "Non-Functional Requirement Design Patterns", "file_type": "document", "source_file": ".claude/knowledge/aidlc-architect-agent/nfr-design-patterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Addresses the gap between it works and it works reliably at scale."}, {"id": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns_cache_aside", "label": "Cache-Aside (Lazy Loading)", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-architect-agent/nfr-design-patterns.md", "source_location": "Caching Strategies", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The default pattern, with the application managing the cache explicitly. Its named risk is a thundering herd on cold start or cache failure, mitigated by cache warming at startup and request coalescing."}, {"id": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns_write_through", "label": "Write-Through Cache", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-architect-agent/nfr-design-patterns.md", "source_location": "Caching Strategies", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cache stays consistent with the database at the cost of two synchronous writes per mutation, so it fits only where reads vastly outnumber writes."}, {"id": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns_write_behind", "label": "Write-Behind (Write-Back) Cache", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-architect-agent/nfr-design-patterns.md", "source_location": "Caching Strategies", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lowest write latency because only the cache write is synchronous, accepting data loss if the cache fails before the batched async write lands - suitable only where brief inconsistency is tolerable."}, {"id": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns_cache_invalidation_rules", "label": "Cache Invalidation Rules", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-architect-agent/nfr-design-patterns.md", "source_location": "Cache Invalidation Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TTL on every item because stale data is worse than a cache miss; explicit invalidation on write where consistency matters; never cache error responses; a hit ratio below 80% means the cache is not helping."}, {"id": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns_circuit_breaker", "label": "Circuit Breaker Pattern", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-architect-agent/nfr-design-patterns.md", "source_location": "Circuit Breaker", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents cascading failure when a downstream service is unavailable. Breakers are per-dependency rather than global, state transitions are logged for observability, and a meaningful fallback (cached data, degraded response, queued retry) is required for the open state to be useful."}, {"id": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns_bulkhead", "label": "Bulkhead Isolation", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-architect-agent/nfr-design-patterns.md", "source_location": "Bulkhead", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-dependency thread pools, connection pools, or process separation stop one failing component from consuming all system resources. Sizing is a trade-off: too small causes needless rejection, too large defeats the isolation."}, {"id": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns_retry_with_exponential_backoff", "label": "Retry with Exponential Backoff", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-architect-agent/nfr-design-patterns.md", "source_location": "Retry with Exponential Backoff", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Always add jitter, because without it retries from multiple clients synchronize into a thundering herd. Cap retries at 3-5 to avoid resource exhaustion, retry only transient failures (429, 5xx, timeouts, resets) and never 400 or 403, and ensure idempotency via idempotency keys."}, {"id": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns_rate_limiting", "label": "Rate Limiting", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-architect-agent/nfr-design-patterns.md", "source_location": "Rate Limiting", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Token bucket allows controlled bursts, sliding window smooths boundary bursts, fixed window is simplest but permits 2x at the boundary. Applied at the gateway for external consumers and per-user or per-tenant for fairness, returning 429 with Retry-After and communicating remaining quota in response headers."}, {"id": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns_load_balancing", "label": "Load Balancing Algorithms and Health Checks", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-architect-agent/nfr-design-patterns.md", "source_location": "Load Balancing", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Round robin for homogeneous instances, least connections for variable request duration, weighted for mixed capacity, consistent hashing to preserve cache affinity. Shallow checks drive load-balancer routing while deep dependency checks drive alerting, so a downstream outage does not eject every healthy instance from the pool."}, {"id": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns_connection_pooling", "label": "Connection Pooling", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-architect-agent/nfr-design-patterns.md", "source_location": "Connection Pooling", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reuses expensive connections instead of creating one per request, with min/max size, acquisition timeout, idle timeout, and a max lifetime that recycles connections by age to prevent stale ones. Sizing formula: RPS x average duration in seconds x 1.5 buffer."}, {"id": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns_graceful_degradation", "label": "Graceful Degradation", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-architect-agent/nfr-design-patterns.md", "source_location": "Graceful Degradation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reduce functionality instead of failing entirely, via feature flags, stale cached fallback with an outdated indicator, defaults, queue-for-later writes, or read-only mode. Every dependency is mapped to a priority tier (critical path, important, nice to have) with its degradation strategy defined before production launch."}], "edges": [{"source": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns", "target": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns_cache_aside", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-architect-agent/nfr-design-patterns.md", "source_location": "Caching Strategies", "weight": 1}, {"source": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns", "target": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns_write_through", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-architect-agent/nfr-design-patterns.md", "source_location": "Caching Strategies", "weight": 1}, {"source": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns", "target": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns_write_behind", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-architect-agent/nfr-design-patterns.md", "source_location": "Caching Strategies", "weight": 1}, {"source": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns", "target": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns_cache_invalidation_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-architect-agent/nfr-design-patterns.md", "source_location": "Cache Invalidation Rules", "weight": 1}, {"source": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns", "target": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns_circuit_breaker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-architect-agent/nfr-design-patterns.md", "source_location": "Circuit Breaker", "weight": 1}, {"source": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns", "target": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns_bulkhead", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-architect-agent/nfr-design-patterns.md", "source_location": "Bulkhead", "weight": 1}, {"source": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns", "target": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns_retry_with_exponential_backoff", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-architect-agent/nfr-design-patterns.md", "source_location": "Retry with Exponential Backoff", "weight": 1}, {"source": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns", "target": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns_rate_limiting", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-architect-agent/nfr-design-patterns.md", "source_location": "Rate Limiting", "weight": 1}, {"source": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns", "target": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns_load_balancing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-architect-agent/nfr-design-patterns.md", "source_location": "Load Balancing", "weight": 1}, {"source": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns", "target": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns_connection_pooling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-architect-agent/nfr-design-patterns.md", "source_location": "Connection Pooling", "weight": 1}, {"source": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns", "target": "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns_graceful_degradation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-architect-agent/nfr-design-patterns.md", "source_location": "Graceful Degradation", "weight": 1}], "hyperedges": [{"id": "cascading_failure_prevention_stack", "label": "Cascading Failure Prevention Stack", "nodes": ["_claude_knowledge_aidlc_architect_agent_nfr_design_patterns_circuit_breaker", "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns_bulkhead", "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns_retry_with_exponential_backoff", "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns_rate_limiting", "_claude_knowledge_aidlc_architect_agent_nfr_design_patterns_graceful_degradation"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/knowledge/aidlc-architect-a