{"nodes": [{"id": "_claude_skills_graphify_skill_graphify", "label": "Graphify Skill", "file_type": "document", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_build_pipeline", "label": "Graphify Build Pipeline", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_fast_path_existing_graph", "label": "Fast Path For Existing Graph", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When graphify-out/graph.json already exists and the request is a natural-language codebase question, Steps 1-5 are skipped entirely: the graph is already built, so re-detecting and re-extracting would spend tokens to reproduce what is on disk."}, {"id": "_claude_skills_graphify_skill_audit_trail", "label": "EXTRACTED / INFERRED / AMBIGUOUS Audit Trail", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every edge carries its evidential status so a reader can tell an explicit source relationship from a model inference; uncertainty is recorded as AMBIGUOUS rather than dropped or promoted."}, {"id": "_claude_skills_graphify_skill_community_detection", "label": "Community Detection And Labeling", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clustering plus human-readable 2-5 word community names surfaces cross-document connections nobody would think to ask about."}, {"id": "_claude_skills_graphify_skill_god_nodes", "label": "God Nodes", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_graph_health_check", "label": "Graph Health Check", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A read-only diagnostic that surfaces edge collapse, dangling/missing endpoints and self-loops - the silent-corruption modes of incremental updates and AST/LLM id mismatches. It never aborts, because the graph is still usable, but the integrity issue must be visible."}, {"id": "_claude_skills_graphify_skill_shrink_guard", "label": "Graph Shrink Guard", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "to_json refuses to write when the new graph has fewer nodes than the existing graph.json, so a failed or empty extraction cannot clobber a good graph, report, or analysis sidecar; the guard message is surfaced rather than forced past."}, {"id": "_claude_skills_graphify_skill_interpreter_sidecar", "label": "Graphify Python Interpreter Sidecar", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The resolved uv/pipx/venv interpreter path is saved to graphify-out/.graphify_python so every later step and subcommand runs on the interpreter that actually has graphify importable."}, {"id": "_claude_skills_graphify_skill_honesty_rules", "label": "Graphify Honesty Rules", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never invent an edge, never skip the corpus warning, always show token cost, never hide cohesion behind symbols, never render a >5000-node visualization without warning."}, {"id": "_claude_skills_graphify_skill_manifest_stamping", "label": "Semantic Manifest Stamping", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only semantic files that actually produced output are stamped: a detected doc whose chunk failed must stay unstamped so the next --update re-queues it, otherwise it is marked done and its content is lost forever."}, {"id": "_claude_skills_graphify_skill_semantic_extraction_subagents", "label": "Parallel Semantic Extraction Subagents", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Doc/paper/image chunks are dispatched to general-purpose subagents in one message because reading files one-by-one is 5-10x slower; Explore is forbidden since it is read-only and would silently drop chunk files."}, {"id": "_claude_skills_graphify_skill_ast_structural_extraction", "label": "AST Structural Extraction", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Code files are covered structurally by a deterministic AST pass, so semantic subagents are only given content files and never re-read every source file."}, {"id": "_claude_skills_graphify_skill_extraction_cache", "label": "Extraction Cache", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cache hits are written and any leftover cache file is deleted when there are none, so the merge step never consumes a stale .graphify_cached.json from a prior run."}], "edges": [{"source": "_claude_skills_graphify_skill_graphify", "target": "_claude_skills_graphify_references_extraction_spec_extraction_subagent_prompt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_skill_graphify", "target": "_claude_skills_graphify_references_query_constrained_query_expansion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_skill_graphify", "target": "_claude_skills_graphify_references_query_bfs_dfs_traversal_modes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_skill_graphify", "target": "_claude_skills_graphify_references_update_incremental_update", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_skill_graphify", "target": "_claude_skills_graphify_references_update_cluster_only", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_skill_graphify", "target": "_claude_skills_graphify_references_add_watch_graphify_add", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1