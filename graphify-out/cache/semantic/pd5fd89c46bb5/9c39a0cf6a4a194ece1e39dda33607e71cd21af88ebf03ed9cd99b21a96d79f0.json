{"nodes": [{"id": "_claude_skills_aidlc_init_skill_intent_birth_initialization_phase", "label": "Intent Birth (Initialization as a Phase)", "file_type": "concept", "source_file": ".claude/skills/aidlc-init/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Initialization is a phase, not a stage - minting the intent, detecting greenfield/brownfield, and building aidlc-state.md happen together in one deterministic call, which is why no per-init-stage runner exists."}, {"id": "_claude_skills_aidlc_init_skill_aidlc_utility_intent_create", "label": "aidlc-utility.ts intent-create", "file_type": "concept", "source_file": ".claude/skills/aidlc-init/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_aidlc_init_skill_kebab_case_label_derivation", "label": "Kebab-Case Record-Dir Label Derivation", "file_type": "rationale", "source_file": ".claude/skills/aidlc-init/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 2-3 word --label becomes the date-prefixed record dir name while the full --arguments text is preserved in audit and state; the description must go through --arguments because intent-create reads it from the flag rather than a positional, and forwarding it bare would silently drop it."}, {"id": "_claude_skills_aidlc_init_skill_aidlc_init", "label": "aidlc-init Skill", "file_type": "document", "source_file": ".claude/skills/aidlc-init/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_claude_skills_aidlc_init_skill_aidlc_init", "target": "_claude_skills_aidlc_init_skill_intent_birth_initialization_phase", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/skills/aidlc-init/SKILL.md", "source_lo