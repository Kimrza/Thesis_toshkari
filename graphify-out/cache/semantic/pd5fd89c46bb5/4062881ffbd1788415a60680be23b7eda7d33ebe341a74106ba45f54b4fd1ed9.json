{"nodes": [{"id": "_claude_knowledge_aidlc_architect_agent_architecture_patterns", "label": "Architecture Patterns", "file_type": "document", "source_file": ".claude/knowledge/aidlc-architect-agent/architecture-patterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No pattern is universally best - each encodes trade-offs between complexity, scalability, team autonomy, and operational cost."}, {"id": "_claude_knowledge_aidlc_architect_agent_architecture_patterns_modular_monolith", "label": "Modular Monolith", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-architect-agent/architecture-patterns.md", "source_location": "Modular Monolith", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The default choice for a new product: one deployable with explicit interfaces between data-owning modules and acyclic declared dependencies. Accepts all-or-nothing scaling and shared technology in exchange for simple deployment, debugging, and cross-module refactoring; extract to services later when boundaries are proven."}, {"id": "_claude_knowledge_aidlc_architect_agent_architecture_patterns_microservices", "label": "Microservices", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-architect-agent/architecture-patterns.md", "source_location": "Microservices", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Justified by independent deployment, divergent scaling needs, polyglot requirements, and mature DevOps/observability - not by size alone. Each service owns its database, communicates only via APIs or events, and assumes every remote call can fail; the cost is distributed-system complexity, per-service operational overhead, and hard integration testing."}, {"id": "_claude_knowledge_aidlc_architect_agent_architecture_patterns_serverless", "label": "Serverless", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-architect-agent/architecture-patterns.md", "source_location": "Serverless", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fits event-driven work, bursty or long-idle traffic, and rapid prototyping. Functions stay stateless and idempotent because events may be delivered more than once, and concurrency limits protect downstream systems. Cold-start latency, vendor lock-in to the provider runtime, and the 15-minute execution ceiling are the accepted costs."}, {"id": "_claude_knowledge_aidlc_architect_agent_architecture_patterns_event_driven_architecture", "label": "Event-Driven Architecture", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-architect-agent/architecture-patterns.md", "source_location": "Event-Driven Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Producers do not know their consumers, which buys loose coupling, independent scaling, and a natural audit trail at the price of eventual consistency, ordering and deduplication complexity, and debugging that requires distributed tracing. Three sub-patterns: event notification, event-carried state transfer, event sourcing."}, {"id": "_claude_knowledge_aidlc_architect_agent_architecture_patterns_cqrs", "label": "CQRS (Command Query Responsibility Segregation)", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-architect-agent/architecture-patterns.md", "source_location": "CQRS", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Apply only when read and write models genuinely diverge. Read models are disposable and rebuildable from the event stream, which is what makes tailoring them to UI needs safe; the cost is two models, synchronization, and eventual consistency - overkill for simple CRUD."}, {"id": "_claude_knowledge_aidlc_architect_agent_architecture_patterns_hexagonal_architecture", "label": "Hexagonal Architecture (Ports and Adapters)", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-architect-agent/architecture-patterns.md", "source_location": "Hexagonal Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The domain depends on nothing external; ports are defined by the domain and adapters translate. Recommended in the domain layer regardless of the outer architectural style, because it is what lets tests run against in-memory adapters with no database or network."}, {"id": "_claude_knowledge_aidlc_architect_agent_architecture_patterns_migration_paths", "label": "Architecture Migration Paths", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-architect-agent/architecture-patterns.md", "source_location": "Migration Paths", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Modular monolith to microservices extracts one module at a time via strangler fig, starting with the least coupled. The reverse path is legitimate: consolidate when services are too small, team boundaries shift, or operational cost exceeds benefit."}, {"id": "_claude_knowledge_aidlc_architect_agent_architecture_patterns_decision_framework", "label": "Pattern Decision Framework", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-architect-agent/architecture-patterns.md", "source_location": "Decision Framework", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Start with a modular monolith unless there are proven reasons not to; extract to microservices only when team autonomy or independent scaling demands it; use serverless for event-driven glue rather than core request-response APIs; apply CQRS only on genuine read/write divergence; use hexagonal in the domain layer always."}], "edges": [{"source": "_claude_knowledge_aidlc_architect_agent_architecture_patterns", "target": "_claude_knowledge_aidlc_architect_agent_architecture_patterns_modular_monolith", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-architect-agent/architecture-patterns.md", "source_location": "Modular Monolith", "weight": 1}, {"source": "_claude_knowledge_aidlc_architect_agent_architecture_patterns", "target": "_claude_knowledge_aidlc_architect_agent_architecture_patterns_microservices", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-architect-agent/architecture-patterns.md", "source_location": "Microservices", "weight": 1}, {"source": "_claude_knowledge_aidlc_architect_agent_architecture_patterns", "target": "_claude_knowledge_aidlc_architect_agent_architecture_patterns_serverless", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-architect-agent/architecture-patterns.md", "source_location": "Serverless", "weight": 1}, {"source": "_claude_knowledge_aidlc_architect_agent_architecture_patterns", "target": "_claude_knowledge_aidlc_architect_agent_architecture_patterns_event_driven_architecture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-architect-agent/architecture-patterns.md", "source_location": "Event-Driven Architecture", "weight": 1}, {"source": "_claude_knowledge_aidlc_architect_agent_architecture_patterns", "target": "_claude_knowledge_aidlc_architect_agent_architecture_patterns_cqrs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-architect-agent/architecture-patterns.md", "source_location": "CQRS", "weight": 1}, {"source": "_claude_knowledge_aidlc_architect_agent_architecture_patterns", "target": "_claude_knowledge_aidlc_architect_agent_architecture_patterns_hexagonal_architecture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-architect-agent/architecture-patterns.md", "source_location": "Hexagonal Architecture", "weight": 1}, {"source": "_claude_knowledge_aidlc_architect_agent_architecture_patterns", "target": "_claude_knowledge_aidlc_architect_agent_architecture_patterns_migration_paths", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-architect-agent/architecture-patterns.md", "source_location": "Migration Paths", "weight": 1}, {"source": "_claude_knowledge_aidlc_architect_agent_architecture_patterns", "target": "_claude_knowledge_aidlc_architect_agent_architecture_patterns_decision_framework", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-architect-agent/architecture-patterns.md", "source_location": "Decision Framework", "weight": 1}, {"source": "_claude_knowledge_aidlc_architect_agent_architecture_patterns_hexagonal_architecture", "target": "_claude_knowledge_aidlc_architect_agent_ddd_patterns_repository_pattern", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".claude/knowledge/aidlc-architect-agent/architecture-patterns.md", "source_location": "Hexagonal Architecture", "weight": 1}, {"source": "_claude_knowledge_aidlc_architect_agent_architecture_patterns_event_driven_architecture", "target": "_claude_knowledge_aidlc_architect_agent_ddd_patterns_domain_events", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".claude/knowledge/aidlc-architect-agent/architecture-patterns.md", "source_location": "Event-Driven Architecture", "weight": 1}, {"source": "_claude_knowledge_aidlc_architect_agent_architecture_patterns_microservices", "target": "_claude_knowledge_aidlc_architect_agent_ddd_patterns_bounded_contexts", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".claude/knowledge/aidlc-architect-agent/architecture-patterns.md", "source_location": "Microservices", "weight": 1}, {"source": "_claude_knowledge_aidlc_architect_agent_architecture_patterns_cqrs", "target": "_claude_knowledge_aidlc_architect_agent_nfr_design_guide_scalability_patterns", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/knowledge/aidlc-architect-agent/architecture-patterns.md", "source_location": "CQRS", "weight": 1}, {"source": "_claude_knowledge_aidlc_architect_agent_architecture_patterns_serverless", "target": "_claude_knowledge_aidlc_aws_platform_agent_cost_optimization_patterns_lambda_cost", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/knowledge/aidlc-architect-agent/architecture-patterns.md", "source_location": "Serverless", "weight": 1}], "hyperedges": []}