{"nodes": [{"id": "_claude_skills_graphify_references_update_incremental_update", "label": "Incremental Update (--update)", "file_type": "concept", "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only new or changed files are re-extracted, saving tokens and time; files carries the changed subset while all_files carries the full corpus for steps needing corpus-wide context."}, {"id": "_claude_skills_graphify_references_update_code_only_fast_path", "label": "Code-Only Change Fast Path", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When every changed file is code, semantic extraction is skipped entirely because AST is deterministic and no LLM is needed."}, {"id": "_claude_skills_graphify_references_update_build_merge_replace_on_reextract", "label": "build_merge Replace-On-Re-Extract", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "build_merge reads graph.json directly with no NetworkX round-trip so edge direction survives, and drops every source_file present in the new chunks before merging so stale nodes for changed files cannot survive."}, {"id": "_claude_skills_graphify_references_update_prune_sources", "label": "prune_sources Deletion Pruning", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "prune_sources is restricted to genuinely deleted files: with root= passed it relativizes to the same base as the freshly merged nodes, so adding changed files there would delete the content just re-extracted. root= is required or nothing is pruned and stale nodes accumulate every update."}, {"id": "_claude_skills_graphify_references_update_cluster_only", "label": "Cluster-Only Rerun", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "graphify cluster-only is self-contained and Steps 5-9 must not be re-run after it, because they read intermediate files that the prior build's cleanup already deleted and would raise FileNotFoundError."}, {"id": "_claude_skills_graphify_references_update_graph_diff", "label": "Graph Diff After Update", "file_type": "concept", "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_claude_skills_graphify_references_update_incremental_update", "target": "_claude_skills_graphify_references_update_code_only_fast_path", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_references_update_incremental_update", "target": "_claude_skills_graphify_references_update_build_merge_replace_on_reextract", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_references_update_build_merge_replace_on_reextract", "target": "_claude_skills_graphify_references_update_prune_sources", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_references_update_i