{"nodes": [{"id": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_application_design_questions_application_design_questions", "label": "Application Design Questions (stage 2.6)", "file_type": "document", "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/application-design-questions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_application_design_questions_q1_method_surface_depth", "label": "Q1 - Method-surface depth (answer B: signatures at package boundaries only)", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/application-design-questions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every defect this project's governance has actually caught travelled across a package boundary, so those contracts are pinned now; intra-package shapes are cheap to change at functional-design and expensive to guess today."}, {"id": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_application_design_questions_q2_config_loading_home", "label": "Q2 - Where config loading, snapshotting and hashing lives (answer B: new src/data/config.py)", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/application-design-questions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Widening release.py or phase_contract.py would push a module past the stated section-12 responsibility that the release and phase-boundary tests key on; the amendment path has a precedent in this project and leaves an auditable record."}, {"id": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_application_design_questions_q3_phase1_import_enforcement", "label": "Q3 - Runtime enforcement of the Phase 1 import prohibition (answer B)", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/application-design-questions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A test that would have failed is worth nothing in a Kaggle session where tests were not run and no commit hook can fire, so the prohibition holds in the run path and the test suite becomes the second independent check."}, {"id": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_application_design_questions_q4_locked_test_guards", "label": "Q4 - Two locked-test guards, path and fold (answer C)", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/application-design-questions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The pre-G-05 coverage audit is a required read while the metrics run is barred until after G-05; one guard cannot express both without conflating a permitted read with a prohibited execution."}, {"id": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_application_design_questions_q5_experiment_registry_writes", "label": "Q5 - Experiment registry write safety (answer C: append-only JSONL plus derived CSV)", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/application-design-questions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Append-only satisfies NFR-AUD-01 by construction; the derived CSV is what makes the registry reviewable by a human at a gate, and marking it derived keeps it inside the affirmed two-tier error posture."}, {"id": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_application_design_questions_q6_determinism_plumbing", "label": "Q6 - Where determinism is plumbed (answer X: centralised helper with bootstrap carve-out)", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/application-design-questions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The environment lock is the reason to centralise, since every run must capture what it applied; the bootstrap seed 20221201 stays separately owned because Vision 8.6 freezes it independently and a model reseed must not touch it."}, {"id": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_application_design_questions_q7_platform_differences", "label": "Q7 - Two-platform differences under four governed configs (answer C)", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/application-design-questions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A platform block in data.yaml would change a governed config hash when a directory moves, firing section 13.7's exact-equality check on an event that is not a scientific change."}, {"id": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_application_design_questions_q8_phase2_interface_scope", "label": "Q8 - How much of Phase 2's interface to design now (answer B: governed boundary only)", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/application-design-questions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TE 6.1's ten-field target row was written for Phase 2's IPP population and proved unsatisfiable on Phase 1's five-column product, which is why D-17 exists; freeze the boundary, not the internals of work no measurement has touched."}, {"id": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_application_design_questions_fu1_pythonhashseed_enforcement", "label": "FU-1 - PYTHONHASHSEED enforcement versus the literal clean-run sequence (answer D)", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/application-design-questions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A variable that must precede interpreter start cannot be set by code the interpreter is already running, so each script re-execs itself and the documented command sequence is amended too, keeping enforcement and documentation in agreement."}, {"id": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_application_design_questions_fu2_locked_test_path_guard_owner", "label": "FU-2 - Which module owns the locked-test path guard (answer A: new src/data/locked_test.py)", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/application-design-questions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Placing it in release.py or prepared.py would reproduce, in a different module, the boundary-widening Q2 rejected on the config loader; folding it into the same amendment makes the marginal cost near zero."}, {"id": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_application_design_questions_fu3_determinism_test_home", "label": "FU-3 - Home for the two homeless determinism checks (answer B: tests/test_determinism.py)", "file_type": "rationale", "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/application-design-questions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Placing a TensorFlow-initialisation check inside test_clean_run.py or test_bootstrap.py hides determinism coverage under an unrelated module name; findability matters more than keeping the mandated module count at 18."}], "edges": [{"source": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_application_design_questions_application_design_questions", "target": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_application_design_questions_q1_method_surface_depth", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/application-design-questions.md", "source_location": null, "weight": 1}, {"source": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_application_design_questions_application_design_questions", "target": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_application_design_questions_q2_config_loading_home", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "aidlc/spaces/default/intents/260813-tec-hourly-forecast/inception/application-design/application-design-questions.md", "source_location": null, "weight": 1}, {"source": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design_application_design_questions_application_design_questions", "target": "aidlc_spaces_default_intents_260813_tec_hourly_forecast_inception_application_design