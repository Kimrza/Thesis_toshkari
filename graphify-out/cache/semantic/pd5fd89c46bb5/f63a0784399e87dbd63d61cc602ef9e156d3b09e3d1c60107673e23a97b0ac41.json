{"nodes": [{"id": "_claude_skills_caveman_commit_skill_caveman_commit", "label": "Caveman Commit Message Generator", "file_type": "document", "source_file": ".claude/skills/caveman-commit/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Why over what \u2014 the diff already says what changed, so the message spends its budget on the non-obvious reason."}, {"id": "_claude_skills_caveman_commit_skill_conventional_commits_format", "label": "Conventional Commits Subject Contract", "file_type": "concept", "source_file": ".claude/skills/caveman-commit/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "`<type>(<scope>): <imperative summary>`, imperative mood, <=50 chars preferred with a hard cap of 72, no trailing period, body wrapped at 72 and issue refs at the end."}, {"id": "_claude_skills_caveman_commit_skill_body_required_cases", "label": "Mandatory Commit Body Cases", "file_type": "rationale", "source_file": ".claude/skills/caveman-commit/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Always include a body for breaking changes, security fixes, data migrations, and reverts \u2014 never compress these into a subject alone, because future debuggers need the context that the diff cannot supply."}, {"id": "_claude_skills_caveman_commit_skill_no_ai_attribution", "label": "No AI Attribution in Commit Messages", "file_type": "concept", "source_file": ".claude/skills/caveman-commit/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No 'this commit does X', no first person, no 'as requested by' (use a Co-authored-by trailer), and no AI-attribution line unless the user's own rule requires an Assisted-by trailer \u2014 in which case it goes in as a trailer, not prose."}], "edges": [{"source": "_claude_skills_caveman_commit_skill_caveman_commit", "target": "_claude_skills_caveman_commit_skill_conventional_commits_format", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/caveman-commit/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_caveman_commit_skill_body_required_cases", "target": "_claude_skills_caveman_commit_skill_caveman_commit", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/caveman-commit/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_caveman_commit_skill_caveman_commit", "target": "_claude_skills_caveman_commit_skill_no_ai_attribution", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/caveman-commit/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_caveman_commit_skill_caveman_commit", "target": "_claude_skills_caveman_skill_caveman", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/skills/caveman-commit/SKILL.md", "source_location": null, "weight": 1.0}], "hyperedges": []}