{"nodes": [{"id": "_claude_knowledge_aidlc_aws_platform_agent_well_architected_framework", "label": "AWS Well-Architected Framework", "file_type": "document", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/well-architected-framework.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Six pillars, each with a headline metric, used at architecture reviews, before production launches, and periodically for existing workloads."}, {"id": "_claude_knowledge_aidlc_aws_platform_agent_well_architected_framework_operational_excellence", "label": "Pillar: Operational Excellence", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/well-architected-framework.md", "source_location": "Pillar 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measured by MTTR. Infrastructure as code, observability, runbooks, deployment automation with automatic rollback, and game days that simulate failure. Anti-patterns named: console changes, error-only logging, no runbooks, Friday-afternoon deploys without monitoring."}, {"id": "_claude_knowledge_aidlc_aws_platform_agent_well_architected_framework_security", "label": "Pillar: Security", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/well-architected-framework.md", "source_location": "Pillar 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IAM roles over long-lived keys with MFA and least privilege, CloudTrail/GuardDuty/Security Hub/Config for detection, KMS at rest and TLS 1.2+ in transit, private subnets and VPC endpoints, pre-provisioned forensics. Anti-patterns: wildcard policies, secrets in env vars or code, public buckets or 0.0.0.0/0 groups, unencrypted stores."}, {"id": "_claude_knowledge_aidlc_aws_platform_agent_well_architected_framework_reliability", "label": "Pillar: Reliability", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/well-architected-framework.md", "source_location": "Pillar 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multi-AZ for critical components, auto scaling in both directions, fault isolation via bulkheads, circuit breakers and timeouts on all remote calls, and chaos engineering. Untested backup restores are called out explicitly: backups that exist but have never been restored are not a recovery capability."}, {"id": "_claude_knowledge_aidlc_aws_platform_agent_well_architected_framework_performance_efficiency", "label": "Pillar: Performance Efficiency", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/well-architected-framework.md", "source_location": "Pillar 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Right-size by measurement rather than guesswork, cache at the appropriate layer, match the database engine to the access pattern, offload long tasks asynchronously, and load test at 2-3x expected peak. Without a performance baseline, degradation cannot be detected at all."}, {"id": "_claude_knowledge_aidlc_aws_platform_agent_well_architected_framework_cost_optimization", "label": "Pillar: Cost Optimization", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/well-architected-framework.md", "source_location": "Pillar 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Visibility through Cost Explorer, budgets and allocation tags; rightsizing from Compute Optimizer; Savings Plans for steady state and Spot for fault-tolerant work; storage lifecycle transitions; and waste elimination (idle instances, unattached volumes, unused Elastic IPs)."}, {"id": "_claude_knowledge_aidlc_aws_platform_agent_well_architected_framework_sustainability", "label": "Pillar: Sustainability", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/well-architected-framework.md", "source_location": "Pillar 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Graviton for performance per watt, scale-to-demand and scheduled non-production shutdowns, managed and serverless services that pool utilization across customers, and deleting unnecessary data - the same levers as cost optimization measured as resources per unit of work."}, {"id": "_claude_knowledge_aidlc_aws_platform_agent_well_architected_framework_review_process", "label": "Well-Architected Review Process", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/well-architected-framework.md", "source_location": "Well-Architected Review Process", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mandatory before production launch and quarterly for critical workloads: scope one workload, walk each pillar's questions with the team, identify high-risk issues, prioritize by risk and effort, assign owners and deadlines, then re-review to verify closure."}], "edges": [{"source": "_claude_knowledge_aidlc_aws_platform_agent_well_architected_framework", "target": "_claude_knowledge_aidlc_aws_platform_agent_well_architected_framework_operational_excellence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-aws-platform-agent/well-architected-framework.md", "source_location": "Pillar 1", "weight": 1}, {"source": "_claude_knowledge_aidlc_aws_platform_agent_well_architected_framework", "target": "_claude_knowledge_aidlc_aws_platform_agent_well_architected_framework_security", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-aws-platform-agent/well-architected-framework.md", "source_location": "Pillar 2", "weight": 1}, {"source": "_claude_knowledge_aidlc_aws_platform_agent_well_architected_framework", "target": "_claude_knowledge_aidlc_aws_platform_agent_well_architected_framework_reliability", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-aws-platform-agent/well-architected-framework.md", "source_location": "Pillar 3", "weight": 1}, {"source": "_claude_knowledge_aidlc_aws_platform_agent_well_architected_framework", "target": "_claude_knowledge_aidlc_aws_platform_agent_well_architected_framework_performance_efficiency", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-aws-platform-agent/well-architected-framework.md", "source_location": "Pillar 4", "weight": 1}, {"source": "_claude_knowledge_aidlc_aws_platform_agent_well_architected_framework", "target": "_claude_knowledge_aidlc_aws_platform_agent_well_architected_framework_cost_optimization", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-aws-platform-agent/well-architected-framework.md", "source_location": "Pillar 5", "weight": 1}, {"source": "_claude_knowledge_aidlc_aws_platform_agent_well_architected_framework", "target": "_claude_knowledge_aidlc_aws_platform_agent_well_architected_framework_sustainability", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-aws-platform-agent/well-architected-framework.md", "source_location": "Pillar 6", "weight": 1}, {"source": "_claude_knowledge_aidlc_aws_platform_agent_well_architected_framework", "target": "_claude_knowledge_aidlc_aws_platform_agent_well_architected_framework_review_process", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-aws-platform-agent/well-architected-framework.md", "source_location": "Well-Architected Review Process", "weight": 1}, {"source": "_claude_knowledge_aidlc_aws_platform_agent_