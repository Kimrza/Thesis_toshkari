{"nodes": [{"id": "_claude_skills_review_tec_governance_references_claude_ai_dlc_integration_overlay_separation", "label": "Overlay Separation From AI-DLC Conductor", "file_type": "rationale", "source_file": ".claude/skills/review-tec-governance/references/claude-ai-dlc-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The skill is never embedded into AI-DLC's shipped conductor, hooks, stage files, agents, or state machine, so it can be reapplied independently when AI-DLC is upgraded. Vision and Technical Environment stay in the repository rather than being copied into the skill, so the review always reads their current approved versions."}, {"id": "_claude_skills_review_tec_governance_references_claude_ai_dlc_integration_governance_overlay_policy", "label": "TEC_Project Governance Overlay Policy", "file_type": "document", "source_file": ".claude/skills/review-tec-governance/references/claude-ai-dlc-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AI-DLC approval and TEC governance are separate: AI-DLC may declare a stage complete, but only the human student or supervisor accepts the TEC gate after reading the governance report, and nothing advances while the verdict is FAIL or NOT REVIEWABLE."}, {"id": "_claude_skills_review_tec_governance_references_claude_ai_dlc_integration_report_supersession_rule", "label": "Report Supersession Rule", "file_type": "concept", "source_file": ".claude/skills/review-tec-governance/references/claude-ai-dlc-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every review gets a new report ID; a prior gate report is never overwritten but superseded with an explicit link, and after remediation the board reruns against the new version while the previous report is preserved."}, {"id": "_claude_skills_review_tec_governance_references_claude_ai_dlc_integration_aidlc_interaction_rules", "label": "AI-DLC Interaction Rules", "file_type": "concept", "source_file": ".claude/skills/review-tec-governance/references/claude-ai-dlc-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run after the stage artifact exists and before human approval, and after phase-boundary verification before handoff. Construction autonomous mode may skip later Bolt gates but never a TEC gate or a full-board trigger, and a governance FAIL returns control to remediation without itself changing AI-DLC state."}], "edges": [{"source": "_claude_skills_review_tec_governance_references_claude_ai_dlc_integration_governance_overlay_policy", "target": "_claude_skills_review_tec_governance_skill_review_tec_governance", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/review-tec-governance/references/claude-ai-dlc-integration.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_review_tec_governance_references_claude_ai_dlc_integration_overlay_separation", "target": "_claude_skills_review_tec_governance_skill_read_only_overlay", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/review-tec-governance/references/claude-ai-dlc-integration.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_review_tec_governance_references_claude_ai_dlc_integration_governance_overlay_policy", "target": "_claude_skills_review_tec_governance_skill_full_board_mode", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/review-tec-governance/references/claude-ai-dlc-integration.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_review_tec_governance_references_claude_ai_dlc_integration_report_supersession