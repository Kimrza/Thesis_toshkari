{"nodes": [{"id": "_claude_aidlc_common_stages_initialization_workspace_scaffold", "label": "Workspace Scaffold Stage", "file_type": "document", "source_file": ".claude/aidlc-common/stages/initialization/workspace-scaffold.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_aidlc_common_stages_initialization_workspace_scaffold_space_knowledge_directory", "label": "Space-Level Knowledge Directory", "file_type": "concept", "source_file": ".claude/aidlc-common/stages/initialization/workspace-scaffold.md", "source_location": "Step 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Free-form and empty at bootstrap, sibling of memory/, codekb/ and intents/, so team domain knowledge accumulates across every intent in the space rather than being trapped in one intent's record. Birth creates no per-agent subdirectories or seeded READMEs; the team creates them."}, {"id": "_claude_aidlc_common_stages_initialization_workspace_scaffold_phase_artifact_directories", "label": "In-Scope Phase Artifact Directories", "file_type": "concept", "source_file": ".claude/aidlc-common/stages/initialization/workspace-scaffold.md", "source_location": "Step 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A phase the scope excludes gets NO directory: an empty operation/ in a bugfix record would read as work planned and skipped when that phase was never in the plan. The phases present are exactly the phases the workflow will run; PHASE_SKIPPED audit events name the rest."}, {"id": "_claude_aidlc_common_stages_initialization_workspace_scaffold_lazy_stage_directories", "label": "Lazy Per-Stage Directory Creation", "file_type": "rationale", "source_file": ".claude/aidlc-common/stages/initialization/workspace-scaffold.md", "source_location": "Step 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-stage dirs appear only when a stage first writes an artifact, so the record only ever shows stages that produced something. This is why reverse-engineering/ never appears up front \u2014 it writes its 9 deliverables to the space-level per-repo codekb store, leaving only its memory.md diary in the intent record."}], "edges": [{"source": "_claude_aidlc_common_stages_initialization_workspace_scaffold", "target": "_claude_aidlc_common_stages_initialization_workspace_scaffold_space_knowledge_directory", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/aidlc-common/stages/initialization/workspace-scaffold.md", "source_location": "Step 2", "weight": 1}, {"source": "_claude_aidlc_common_stages_initialization_workspace_scaffold", "target": "_claude_aidlc_common_stages_initialization_workspace_scaffold_phase_artifact_directories", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/aidlc-common/stages/initialization/workspace-scaffold.md", "source_location": "Step 3", "weight": 1}, {"source": "_claude_aidlc_common_stages_initialization_workspace_scaffold", "target": "_claude_aidlc_common_stages_initialization_workspace_scaffold_lazy_stage_directories", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/aidlc-common/stages/initialization/workspace-scaffold.md", "source_location": "Step 3", "weight": 1}, {"source": "_claude_aidlc_common_stages_initialization_workspace_scaffold_phase_artifact_directories", "target": "_claude_aidlc_common_stages_initialization_workspace_scaffold_lazy_stage_directories", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".claude/aidlc-common/stages/initialization/workspace-scaffold.md", "source_location": "Step 3", "weight": 1}], "hyperedges": []}