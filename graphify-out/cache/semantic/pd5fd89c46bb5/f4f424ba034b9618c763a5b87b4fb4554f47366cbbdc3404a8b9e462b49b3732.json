{"nodes": [{"id": "_claude_tools_data_memory_seed_org_org_level_rules", "label": "Org-Level Rules Seed", "file_type": "document", "source_file": ".claude/tools/data/memory-seed/org.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_tools_data_memory_seed_org_rule_layer_resolution", "label": "Strict-Additive Rule Layer Resolution", "file_type": "concept", "source_file": ".claude/tools/data/memory-seed/org.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The resolver loads every applicable layer org -> team -> project; narrower layers add specialisation and must not contradict broader policy."}, {"id": "_claude_tools_data_memory_seed_org_trunk_based_development", "label": "Trunk-Based Development Default", "file_type": "concept", "source_file": ".claude/tools/data/memory-seed/org.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All work merges to main via short-lived branches because long-lived branches accumulate merge debt; multiple environments are gated by tags or deployment configs rather than long-lived release branches."}, {"id": "_claude_tools_data_memory_seed_org_squash_merge_bolts", "label": "Squash-Merge Of Bolt Branches", "file_type": "rationale", "source_file": ".claude/tools/data/memory-seed/org.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each Bolt becomes one commit so main's linear history maps 1:1 to delivery-planning's Bolt sequence; losing intermediate commits on main is accepted because the audit log preserves the full event sequence."}, {"id": "_claude_tools_data_memory_seed_org_walking_skeleton_ceremony", "label": "Walking Skeleton Ceremony Toggle", "file_type": "concept", "source_file": ".claude/tools/data/memory-seed/org.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bolt 1 runs solo and gated only when the active scope declares skeleton: on; with skeleton: off there is nothing to bootstrap and the first Bolt runs like any other."}, {"id": "_claude_tools_data_memory_seed_org_ladder_prompt", "label": "Construction Ladder Prompt", "file_type": "concept", "source_file": ".claude/tools/data/memory-seed/org.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After Bolt 1 ships the team chooses whether remaining Bolts run autonomously or gated, persisted as Construction Autonomy Mode in aidlc-state.md."}, {"id": "_claude_tools_data_memory_seed_org_testing_posture_defaults", "label": "Per-Scope Testing Posture Defaults", "file_type": "concept", "source_file": ".claude/tools/data/memory-seed/org.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_tools_data_memory_seed_org_deploy_on_merge", "label": "Deploy-On-Merge Default", "file_type": "concept", "source_file": ".claude/tools/data/memory-seed/org.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_tools_data_memory_seed_org_code_style_deference", "label": "Code Style Deference To Project Config", "file_type": "rationale", "source_file": ".claude/tools/data/memory-seed/org.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Agents read the project's linter config first and only suggest a style change the linter does not already cover, so the framework never fights the repo's own tooling."}, {"id": "_claude_tools_data_memory_seed_org_conversation_language_resolution", "label": "Conversation Language Resolution", "file_type": "concept", "source_file": ".claude/tools/data/memory-seed/org.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A delegated agent never sees the conversation, so the orchestrator restates the language in every brief; the brief is authoritative because it is regenerated per dispatch and can never be staler than a persisted rule, and project.md outranks team.md because only project.md ever records a switch."}, {"id": "_claude_tools_data_memory_seed_org_conversation_language_stability", "label": "Conversation Language Stability", "file_type": "concept", "source_file": ".claude/tools/data/memory-seed/org.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only an explicit human request switches the language, and it takes effect immediately; persistence via the human-gated learnings ritual is a separate step, and direct memory edits are forbidden because they skip the audit event, duplicate key, and admission conflict-check. A new session re-resolves rather than defaulting to English."}, {"id": "_claude_tools_data_memory_seed_org_conversation_language_localization", "label": "Conversation Language Localization Scope", "file_type": "concept", "source_file": ".claude/tools/data/memory-seed/org.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_tools_data_memory_seed_org_conversation_language_preserved_tokens", "label": "Conversation Language Preserved Tokens", "file_type": "concept", "source_file": ".claude/tools/data/memory-seed/org.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Literals a stage spells in backticks stay English character-for-character because engines compare filled answers against the literal; only the prose around them is localized."}], "edges": [{"source": "_claude_tools_data_memory_seed_org_org_level_rules", "target": "_claude_tools_data_memory_seed_org_rul