{"nodes": [{"id": "_claude_knowledge_aidlc_compliance_agent_regulatory_frameworks", "label": "Regulatory Frameworks", "file_type": "document", "source_file": ".claude/knowledge/aidlc-compliance-agent/regulatory-frameworks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_knowledge_aidlc_compliance_agent_regulatory_frameworks_pci_dss", "label": "PCI-DSS", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-compliance-agent/regulatory-frameworks.md", "source_location": "PCI-DSS", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Twelve requirements mapped to AWS controls, with scope reduction as the highest-leverage move: tokenizing through a compliant processor so raw card numbers never enter the system makes most requirements inapplicable rather than merely satisfied. Log retention at least one year."}, {"id": "_claude_knowledge_aidlc_compliance_agent_regulatory_frameworks_hipaa", "label": "HIPAA", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-compliance-agent/regulatory-frameworks.md", "source_location": "HIPAA", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A BAA is required before storing PHI and only HIPAA-eligible services may be used, verified per service. Encryption at rest and in transit satisfies Safe Harbor, audit logs retain 6 years, breach notification runs within 60 days, and PHI is isolated in dedicated accounts or VPCs with PrivateLink so it never traverses the public internet."}, {"id": "_claude_knowledge_aidlc_compliance_agent_regulatory_frameworks_soc2", "label": "SOC 2", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-compliance-agent/regulatory-frameworks.md", "source_location": "SOC 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Type I attests design at a point in time and is faster; Type II attests operating effectiveness over 6-12 months and is more valued. Security is the only mandatory Trust Service Criterion; evidence collection is automated with Config conformance packs and Security Hub rather than gathered by hand."}, {"id": "_claude_knowledge_aidlc_compliance_agent_regulatory_frameworks_gdpr", "label": "GDPR", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-compliance-agent/regulatory-frameworks.md", "source_location": "GDPR", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Applies by data subject residency, not company location. Six principles plus five data subject rights translate into engineering work: DSAR automation, soft-delete with configurable retention, DynamoDB TTL or S3 lifecycle for automatic expiry, and tagged PII stores for governance."}, {"id": "_claude_knowledge_aidlc_compliance_agent_regulatory_frameworks_data_residency", "label": "Data Residency and Sovereignty", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-compliance-agent/regulatory-frameworks.md", "source_location": "Data Residency and Sovereignty", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Residency is where data is stored; sovereignty is whose law then applies to it. Enforced with region-restricting SCPs, bucket and table placement, and cross-region replication that respects residency - with documented cross-region data flows for audits."}, {"id": "_claude_knowledge_aidlc_compliance_agent_regulatory_frameworks_privacy_impact_assessment", "label": "Privacy Impact Assessment", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-compliance-agent/regulatory-frameworks.md", "source_location": "Privacy Impact Assessment", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five steps run when processing is introduced or materially changed: describe the processing, test proportionality (could the same outcome be reached with less data), identify risks including function creep, define mitigations, then document and review annually."}, {"id": "_claude_knowledge_aidlc_compliance_agent_regulatory_frameworks_compliance_as_code", "label": "Compliance-as-Code Patterns", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-compliance-agent/regulatory-frameworks.md", "source_location": "Compliance-as-Code Patterns", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Automate verification instead of relying on manual audits: Config rules and conformance packs per framework, Security Hub aggregation and scoring, cdk-nag enforcing rules at synthesis time (AwsSolutions, NIST80053R5, HIPAASecurity, PCIDSS321 check packs), and Lambda-backed custom rules for organization-specific requirements."}, {"id": "_claude_knowledge_aidlc_compliance_agent_regulatory_frameworks_audit_trail_requirements", "label": "Audit Trail Requirements", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-compliance-agent/regulatory-frameworks.md", "source_location": "Audit Trail Requirements", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The one requirement common to every framework: CloudTrail in all regions and accounts to a centralized immutable Object Lock bucket, application-level who-did-what-when logs with authentication context, integrity validation, framework-specific retention (PCI 1 year, HIPAA 6 years), and meta-auditing of access to the logs themselves."}], "edges": [{"source": "_claude_knowledge_aidlc_compliance_agent_regulatory_frameworks", "target": "_claude_knowledge_aidlc_compliance_agent_regulatory_frameworks_pci_dss", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-compliance-agent/regulatory-frameworks.md", "source_location": "PCI-DSS", "weight": 1}, {"source": "_claude_knowledge_aidlc_compliance_agent_regulatory_frameworks", "target": "_claude_knowledge_aidlc_compliance_agent_regulatory_frameworks_hipaa", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-compliance-agent/regulatory-frameworks.md", "source_location": "HIPAA", "weight": 1}, {"source": "_claude_knowledge_aidlc_compliance_agent_regulatory_frameworks", "target": "_claude_knowledge_aidlc_compliance_agent_regulatory_frameworks_soc2", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-compliance-agent/regulatory-frameworks.md", "source_location": "SOC 2", "weight": 1}, {"source": "_claude_knowledge_aidlc_compliance_agent_regulatory_frameworks", "target": "_claude_knowledge_aidlc_compliance_agent_regulatory_frameworks_gdpr", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-compliance-agent/regulatory-frameworks.md", "source_location": "GDPR", "weight": 1}, {"source": "_claude_knowledge_aidlc_compliance_agent_regulatory_frameworks", "target": "_claude_knowledge_aidlc_compliance_agent_regulatory_frameworks_data_residency", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-compliance-agent/regulatory-frameworks.md", "source_location": "Data Residency and Sovereignty", "weight": 1}, {"source": "_claude_knowledge_aidlc_compliance_agent_regulatory_frameworks", "target": "_claude_knowledge_aidlc_compliance_agent_regulatory_frameworks_privacy_impact_assessment", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-compliance-agent/regulatory-frameworks.md", "source_location": "Privacy Impact Assessment", "weight": 1}, {"source": "_claude_knowledge_aidlc_compliance_agent_regulatory_frameworks", "target": "_claude_knowledge_aidlc_compliance_agent_regulatory_frameworks_compliance_as_code", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-compliance-agent/regulatory-frameworks.md", "source_location": "Compliance-as-Code Patterns", "weight": 1}, {"source": "_claude_knowledge_aidlc_compliance_agent_regulatory_frameworks", "target": "_claude_knowledge_aidlc_compliance_agent_regulatory_frameworks_audit_trail_requirements", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-compliance-agent/regulatory-frameworks.md", "source_location": "Audit Trail Requirements", "weight": 1}, {"source": "_claude_knowledge_aidlc_compliance_agent_regulatory_frameworks_compliance_as_code", "target": "_claude_aidlc_common_stages_operation_environment_provisioning", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": ".claude/knowledge/aidlc-compliance-agent/regulatory-frameworks.md", "source_location": "Compliance-as-Code Patterns", "weight": 1}, {"source": "_claude_knowledge_aidlc_compliance_agent_regulatory_frameworks_compliance_as_code", "target": "_claude_aidlc_common_stages_operation_feedback_optimization_drift_report", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/knowledge/aidlc-compliance-agent/regulatory-frameworks.md", "source_location": "Compliance-as-Code Patterns", "weight": 1}], "hyperedges": []}