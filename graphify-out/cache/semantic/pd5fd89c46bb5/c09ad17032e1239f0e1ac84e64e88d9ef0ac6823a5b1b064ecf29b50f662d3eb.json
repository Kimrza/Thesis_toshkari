{"nodes": [{"id": "_claude_knowledge_aidlc_aws_platform_agent_cost_optimization_patterns", "label": "AWS Cost Optimization Patterns", "file_type": "document", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/cost-optimization-patterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cost optimization is an ongoing discipline, not a one-time exercise."}, {"id": "_claude_knowledge_aidlc_aws_platform_agent_cost_optimization_patterns_compute_rightsizing", "label": "Compute Rightsizing", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/cost-optimization-patterns.md", "source_location": "Compute: Rightsizing", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compute Optimizer after 14 days of data, resized in non-production first. Most teams over-provision by 30-50% at initial deployment, Graviton gives 20-40% better price-performance, and non-production instances are scheduled off outside business hours."}, {"id": "_claude_knowledge_aidlc_aws_platform_agent_cost_optimization_patterns_pricing_models", "label": "AWS Pricing Model Selection", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/cost-optimization-patterns.md", "source_location": "Pricing Models", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compute Savings Plans cover the baseline because they span EC2, Lambda and Fargate; On-Demand absorbs the peaks; Reserved Instances only for very predictable instance types. Spot buys up to 90% off for interruption-tolerant work and is never used for databases or single-instance workloads."}, {"id": "_claude_knowledge_aidlc_aws_platform_agent_cost_optimization_patterns_s3_lifecycle_policies", "label": "S3 Lifecycle Policies", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/cost-optimization-patterns.md", "source_location": "Storage: S3 Lifecycle Policies", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transitions are validated against measured access patterns via Storage Lens and S3 analytics rather than assumed; Intelligent-Tiering handles unpredictable access; incomplete multipart uploads are deleted after 7 days because they accumulate silently."}, {"id": "_claude_knowledge_aidlc_aws_platform_agent_cost_optimization_patterns_dynamodb_capacity", "label": "DynamoDB Capacity Mode Selection", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/cost-optimization-patterns.md", "source_location": "Database: DynamoDB", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On-Demand for spiky or new tables, provisioned with auto-scaling plus reserved capacity for steady production. TTL deletions carry no write cost, and evenly distributed partition keys matter for cost because hot partitions waste provisioned capacity."}, {"id": "_claude_knowledge_aidlc_aws_platform_agent_cost_optimization_patterns_lambda_cost", "label": "Lambda Cost Optimization", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/cost-optimization-patterns.md", "source_location": "Lambda Cost Optimization", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Because cost is memory x duration x invocations and more memory also means more CPU, raising memory can lower total cost - Power Tuning finds the point. arm64 saves about 20%, SQS batching and EventBridge content filtering cut invocation counts, and provisioned concurrency is avoided unless latency demands it."}, {"id": "_claude_knowledge_aidlc_aws_platform_agent_cost_optimization_patterns_cost_allocation_tagging", "label": "Cost Allocation Tagging", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/cost-optimization-patterns.md", "source_location": "Cost Allocation Tagging", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A minimum tag set (Project, Environment, Team, CostCenter, Service) enforced by Organizations SCPs and CDK Aspects, and activated in the Billing console - untagged resources cannot be attributed to a team in Cost Explorer at all."}, {"id": "_claude_knowledge_aidlc_aws_platform_agent_cost_optimization_patterns_cost_anomaly_detection", "label": "Cost Reviews and Anomaly Detection", "file_type": "concept", "source_file": ".claude/knowledge/aidlc-aws-platform-agent/cost-optimization-patterns.md", "source_location": "Cost Explorer Queries", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Monthly reviews by service, tag, daily trend and usage type, plus Cost Anomaly Detection and budget alerts at 50/80/100% with separate budgets per environment, so a spike is caught in days rather than at the invoice."}], "edges": [{"source": "_claude_knowledge_aidlc_aws_platform_agent_cost_optimization_patterns", "target": "_claude_knowledge_aidlc_aws_platform_agent_cost_optimization_patterns_compute_rightsizing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-aws-platform-agent/cost-optimization-patterns.md", "source_location": "Compute: Rightsizing", "weight": 1}, {"source": "_claude_knowledge_aidlc_aws_platform_agent_cost_optimization_patterns", "target": "_claude_knowledge_aidlc_aws_platform_agent_cost_optimization_patterns_pricing_models", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".claude/knowledge/aidlc-aws-platform-agent/cost-optimization-patterns.md", "source_location": "Pricing Models", "weight": 1}, {"source": "_claude_knowledge_aidlc_aws_platform_agent_cost_optimization_patterns", "target": "_claude_knowledge_aidlc_aws_platform_agent_cost_optimization_patterns_s3_lifecycle_policies",